<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Umbrella.Wallet.App.Views.SplashWindow"
        Width="460" Height="380"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#070B14">

  <!-- Small animated intro window: the brand mark scales + fades in over a breathing blue glow,
       then App.axaml.cs reveals the main window and closes this one. Solid (no transparency) so it
       renders identically on every machine. -->
  <Border CornerRadius="24" Background="#070B14" BorderBrush="#1E2A3D" BorderThickness="1">
    <Panel>
      <Ellipse Width="540" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="splashGlow"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
        <Image Source="avares://Umbrella.Wallet.App/Assets/umbrella-logo-solidwhite.png"
               Width="112" HorizontalAlignment="Center" Classes="splashLogo"/>
        <TextBlock Text="UMBRELLA WALLET" FontSize="24" FontWeight="SemiBold" LetterSpacing="6"
                   HorizontalAlignment="Center" Foreground="#F7F9FC" Classes="splashTitle"/>
        <TextBlock Text="Secure. Simple. Protected." FontSize="13" HorizontalAlignment="Center"
                   Foreground="#8994A7" Classes="splashSub"/>
      </StackPanel>
    </Panel>
  </Border>
</Window>
