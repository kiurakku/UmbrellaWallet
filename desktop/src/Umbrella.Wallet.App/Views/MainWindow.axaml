<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Umbrella.Wallet.App.ViewModels"
        xmlns:app="using:Umbrella.Wallet.App"
        xmlns:lottie="using:Avalonia.Labs.Lottie"
        xmlns:net="using:Umbrella.Wallet.Infrastructure.Network"
        xmlns:infra="using:Umbrella.Wallet.Infrastructure"
        xmlns:controls="using:Umbrella.Wallet.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1240"
        d:DesignHeight="820"
        x:Class="Umbrella.Wallet.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        x:Name="RootWindow"
        Title="Umbrella Wallet"
        Icon="avares://Umbrella.Wallet.App/Assets/umbrella-appicon.png"
        Width="1240"
        Height="820"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="{DynamicResource UmBg}">

  <Window.Resources>
    <app:StringEqualsConverter x:Key="StringEquals" />
    <app:MarketFilterConverter x:Key="MarketFilter" />
    <app:ToastBorderConverter x:Key="ToastBorder" />
    <app:ToastGlyphConverter x:Key="ToastGlyph" />
    <app:ChangeWashConverter x:Key="ChangeWash" />
    <app:ActivityLabelConverter x:Key="ActivityLabel" />
  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="36,*">

    <!-- No visible chrome panel (per design): just an invisible strip so the window still drags
         (double-click maximises) and the native min/max/close buttons have their room. Status and
         errors surface on the screens that need them (e.g. the unlock form), not a top bar. -->
    <Border Grid.Row="0" Background="Transparent" PointerPressed="OnTitleBarPressed"/>

    <Grid Grid.Row="1">

      <!-- Lock-screen backdrop (a moody coastline), so the unlock screen isn't a flat black. Behind
           everything and only while the vault is locked; a scrim keeps the form readable. -->
      <Image Source="avares://Umbrella.Wallet.App/Assets/lock-bg.jpg" Stretch="UniformToFill"
             IsVisible="{Binding ShowDefaultLockBg}" Opacity="0.5"/>
      <Image Source="{Binding LockBgImage}" Stretch="UniformToFill"
             IsVisible="{Binding ShowCustomLockBg}" Opacity="0.5"/>
      <Border Background="#BF05050A" IsVisible="{Binding IsUnlockStage}"/>

      <!-- News article overlay — floats above everything when a news item is opened. -->
      <Border ZIndex="200" IsVisible="{Binding IsNewsOpen}" Background="#C4000000">
        <Border Classes="card" MaxWidth="640" MaxHeight="600" Margin="28"
                VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource UmAccent}">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{Binding SelectedNews.TagColor}" CornerRadius="6" Padding="8,3">
                  <TextBlock Text="{Binding SelectedNews.Tag}" FontSize="10" FontWeight="SemiBold" Foreground="#0C0D10" LetterSpacing="1"/>
                </Border>
                <TextBlock Text="{Binding SelectedNews.Date}" FontSize="12" Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="{Binding [common.close], Source={x:Static app:Loc.Instance}}" FontSize="12" Command="{Binding CloseNewsCommand}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
              <StackPanel Spacing="12">
                <TextBlock Classes="serif" Text="{Binding SelectedNews.Title}" FontSize="23" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedNews.Body}" FontSize="13.5" LineHeight="22"
                           Foreground="{DynamicResource UmTextSoft}" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Border>

      <!-- ============================ ONBOARDING (no sidebar) ============================ -->
      <ScrollViewer x:Name="OnbScroll" IsVisible="{Binding !ShowSidebar}" AllowAutoHide="True"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
        <!-- MinHeight = viewport, so short stages (unlock/restore) exactly fill it and centre without
             scrolling; taller stages (welcome/backup) grow past it and scroll. The panel carries NO
             extra margin — a bottom margin here made even the short unlock screen overflow by 40px and
             scroll. Tall stages supply their own bottom spacing via their content margins. -->
        <Panel MinHeight="{Binding #OnbScroll.Bounds.Height}">

          <!-- Welcome / cover -->
          <StackPanel IsVisible="{Binding IsWelcomeStage}" MaxWidth="720" Margin="24,48,24,24"
                      HorizontalAlignment="Center" Spacing="0">
            <!-- Brand mark stays the logo; the Telegram sticker sits beside it as a greeting
                 rather than replacing the identity. -->
            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
              <!-- Original Umbrella Wallet wordmark; the greeting sticker moved into the Local-first card. -->
              <Image Source="{Binding LogoImage}" Width="132" Stretch="Uniform" HorizontalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="UMBRELLA WALLET" FontSize="30" FontWeight="SemiBold" LetterSpacing="4"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding [app.tagline], Source={x:Static app:Loc.Instance}}"
                       Foreground="{DynamicResource UmTextDim}" FontSize="13.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,32,0,0">
              <Border Classes="hairline" Padding="16,18">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/GhostPepe.json"
                                 Width="48" Height="48" HorizontalAlignment="Center"
                                 RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                  <TextBlock Text="{Binding [welcome.anon], Source={x:Static app:Loc.Instance}}" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource UmTextDim}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding [welcome.anonSub], Source={x:Static app:Loc.Instance}}" FontSize="11.5" Foreground="{DynamicResource UmTextMuted}"
                             TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="hairline" Padding="16,18">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/encryption.json"
                                 Width="48" Height="48" HorizontalAlignment="Center"
                                 RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                  <TextBlock Text="{Binding [welcome.keys], Source={x:Static app:Loc.Instance}}" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource UmTextDim}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding [welcome.keysSub], Source={x:Static app:Loc.Instance}}" FontSize="11.5" Foreground="{DynamicResource UmTextMuted}"
                             TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="hairline" Padding="16,18">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                  <!-- Animated sticker (moved here from beside the logo) instead of a bare ⚡ emoji, so all
                       three feature cards carry a themed sticker. -->
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/wau.json"
                                 Width="48" Height="48" HorizontalAlignment="Center"
                                 RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                  <TextBlock Text="{Binding [welcome.local], Source={x:Static app:Loc.Instance}}" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource UmTextDim}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding [welcome.localSub], Source={x:Static app:Loc.Instance}}" FontSize="11.5" Foreground="{DynamicResource UmTextMuted}"
                             TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card" Margin="0,20,0,0">
              <TextBlock Foreground="{DynamicResource UmTextSoft}" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                         Text="{Binding [welcome.blurb], Source={x:Static app:Loc.Instance}}"/>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,24,0,0">
              <Button Classes="primary" Content="{Binding [onboard.createBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding GoToCreateCommand}"/>
              <Button Classes="ghost" Content="{Binding [onboard.importBtn], Source={x:Static app:Loc.Instance}}" Command="{Binding GoToImportCommand}"/>
            </StackPanel>

            <!-- Only while adding an additional wallet: a way back to the wallet you already had. -->
            <Button Classes="ghost" Content="{Binding [onboard.cancelBack], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Center" Margin="0,14,0,0"
                    IsVisible="{Binding IsAddingWallet}" Command="{Binding CancelAddWalletCommand}"/>

            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" Margin="0,28,0,0">
              <TextBlock Text="{Binding [onboard.builtBy], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmBorder3}" FontSize="11" VerticalAlignment="Center"/>
              <!-- the fear maker's mark — the gold ghost, beside the name. -->
              <Image Source="{Binding FearMark}" Width="30" Height="30" VerticalAlignment="Center"/>
              <TextBlock Text="the fear" Foreground="{DynamicResource UmGold}" FontSize="13.5" FontWeight="Bold"
                         LetterSpacing="0.5" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding [onboard.brandTagline], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmBorder3}" FontSize="11"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <!-- Create -->
          <StackPanel IsVisible="{Binding IsCreateStage}" MaxWidth="480" Margin="24,40,24,24"
                      HorizontalAlignment="Center" Spacing="0">
            <Button Classes="ghost" Content="{Binding [common.back], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left" Padding="12,7"
                    Command="{Binding GoToWelcomeCommand}"/>
            <TextBlock Classes="serif" FontSize="30" Text="{Binding [onboard.create], Source={x:Static app:Loc.Instance}}" Margin="0,20,0,0"/>
            <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="{Binding [onboard.createDesc], Source={x:Static app:Loc.Instance}}"/>

            <StackPanel Spacing="0" IsVisible="{Binding ShowVaultPasswordFields}">
              <TextBlock Classes="eyebrow" Text="{Binding [onboard.vaultPassword], Source={x:Static app:Loc.Instance}}" Margin="0,22,0,8"/>
              <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="{Binding [onboard.pwPlaceholder], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock Classes="mono" FontSize="11" Margin="2,8,0,0"
                         Text="{Binding PasswordMeterLabel}" Foreground="{Binding PasswordMeterColor}"/>
              <TextBlock Classes="eyebrow" Text="{Binding [onboard.confirmPassword], Source={x:Static app:Loc.Instance}}" Margin="0,16,0,8"/>
              <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="{Binding [onboard.pwRepeat], Source={x:Static app:Loc.Instance}}"/>
            </StackPanel>
            <!-- Additional wallets reuse the one app password, so no new password is asked. -->
            <Border IsVisible="{Binding ReuseAppPassword}" Background="{DynamicResource UmCardAlt}"
                    CornerRadius="8" Padding="12,9" Margin="0,20,0,0">
              <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                         Text="{Binding [onboard.reusePw], Source={x:Static app:Loc.Instance}}"/>
            </Border>

            <Border IsVisible="{Binding HasFormError}" Background="#2A1618" BorderBrush="#7A3034"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
              <TextBlock Text="{Binding FormError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <Button Classes="primary" Content="{Binding [onboard.createSubmit], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Margin="0,18,0,0"
                    IsEnabled="{Binding !IsBusy}" Command="{Binding CreateWalletCommand}"/>
            <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="{Binding [onboard.cryptoNote], Source={x:Static app:Loc.Instance}}"/>
          </StackPanel>

          <!-- Import -->
          <StackPanel IsVisible="{Binding IsImportStage}" MaxWidth="520" Margin="24,40,24,24"
                      HorizontalAlignment="Center" Spacing="0">
            <Button Classes="ghost" Content="{Binding [common.back], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left" Padding="12,7"
                    Command="{Binding GoToWelcomeCommand}"/>
            <TextBlock Classes="serif" FontSize="30" Text="{Binding [onboard.import], Source={x:Static app:Loc.Instance}}" Margin="0,20,0,0"/>
            <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="{Binding [onboard.importDesc], Source={x:Static app:Loc.Instance}}"/>

            <TextBlock Classes="eyebrow" Text="{Binding [onboard.recoveryPhrase], Source={x:Static app:Loc.Instance}}" Margin="0,22,0,8"/>
            <TextBox Text="{Binding ImportPhrase}" AcceptsReturn="True" Height="120"
                     TextWrapping="Wrap" Watermark="{Binding [onboard.phrasePh], Source={x:Static app:Loc.Instance}}"/>
            <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"
                       Text="{Binding [onboard.importNote], Source={x:Static app:Loc.Instance}}"/>

            <StackPanel Spacing="0" IsVisible="{Binding ShowVaultPasswordFields}">
              <TextBlock Classes="eyebrow" Text="{Binding [onboard.vaultPassword], Source={x:Static app:Loc.Instance}}" Margin="0,16,0,8"/>
              <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="{Binding [onboard.pwPlaceholder], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock Classes="mono" FontSize="11" Margin="2,8,0,0"
                         Text="{Binding PasswordMeterLabel}" Foreground="{Binding PasswordMeterColor}"/>
              <TextBlock Classes="eyebrow" Text="{Binding [onboard.confirmPassword], Source={x:Static app:Loc.Instance}}" Margin="0,16,0,8"/>
              <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="{Binding [onboard.pwRepeat], Source={x:Static app:Loc.Instance}}"/>
            </StackPanel>
            <Border IsVisible="{Binding ReuseAppPassword}" Background="{DynamicResource UmCardAlt}"
                    CornerRadius="8" Padding="12,9" Margin="0,16,0,0">
              <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                         Text="{Binding [onboard.reusePw], Source={x:Static app:Loc.Instance}}"/>
            </Border>

            <Border IsVisible="{Binding HasFormError}" Background="#2A1618" BorderBrush="#7A3034"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
              <TextBlock Text="{Binding FormError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <Button Classes="primary" Content="{Binding [onboard.importSubmit], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Margin="0,18,0,0"
                    IsEnabled="{Binding !IsBusy}" Command="{Binding ImportWalletCommand}"/>
          </StackPanel>

          <!-- Unlock -->
          <StackPanel IsVisible="{Binding IsUnlockStage}" MaxWidth="460" Margin="24"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
            <Image Source="{Binding LogoImage}"
                   Width="110" Stretch="Uniform" HorizontalAlignment="Center"/>

            <!-- Normal unlock -->
            <StackPanel IsVisible="{Binding !IsResettingPassword}" Spacing="0">
              <TextBlock Classes="serif" FontSize="28" Text="{Binding [onboard.unlock], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
              <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                         Text="{Binding [unlock.subtitle], Source={x:Static app:Loc.Instance}}"/>
              <!-- Enter submits the unlock, so a returning user never has to reach for the mouse. -->
              <TextBox Text="{Binding Password}" PasswordChar="●" Margin="0,22,0,0"
                       Watermark="{Binding [unlock.pw], Source={x:Static app:Loc.Instance}}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>


              <Border IsVisible="{Binding HasFormError}" Background="#2A1618" BorderBrush="#7A3034"
                      BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
                <TextBlock Text="{Binding FormError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
              </Border>
              <Button Classes="primary" Content="{Binding [unlock.btn], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Margin="0,16,0,0"
                      IsEnabled="{Binding !IsBusy}" Command="{Binding UnlockCommand}"/>
              <Button Classes="ghost" Content="{Binding [unlock.forgot], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Center" Margin="0,12,0,0"
                      FontSize="12" Command="{Binding BeginPasswordResetCommand}"/>
            </StackPanel>

            <!-- Forgot-password: restore this wallet from its recovery phrase + a new password -->
            <StackPanel IsVisible="{Binding IsResettingPassword}" Spacing="0">
              <TextBlock Classes="serif" FontSize="26" Text="{Binding [onboard.restore], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
              <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                         Text="{Binding [onboard.restoreDesc], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock Classes="eyebrow" Text="{Binding [onboard.recoveryPhrase], Source={x:Static app:Loc.Instance}}" Margin="0,20,0,8"/>
              <TextBox Text="{Binding ImportPhrase}" AcceptsReturn="True" Height="110" TextWrapping="Wrap"
                       Watermark="{Binding [onboard.phrasePhShort], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock Classes="eyebrow" Text="{Binding [onboard.newPassword], Source={x:Static app:Loc.Instance}}" Margin="0,14,0,8"/>
              <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="{Binding [onboard.pwPlaceholder], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock Classes="mono" FontSize="11" Margin="2,8,0,0"
                         Text="{Binding PasswordMeterLabel}" Foreground="{Binding PasswordMeterColor}"/>
              <TextBlock Classes="eyebrow" Text="{Binding [onboard.confirmNewPassword], Source={x:Static app:Loc.Instance}}" Margin="0,14,0,8"/>
              <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="{Binding [onboard.pwRepeatNew], Source={x:Static app:Loc.Instance}}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding ResetWithSeedCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
              <Border Background="#2A2016" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
                <TextBlock Foreground="#E7CA83" TextWrapping="Wrap" FontSize="11.5"
                           Text="{Binding [onboard.restoreWarn], Source={x:Static app:Loc.Instance}}"/>
              </Border>
              <Border IsVisible="{Binding HasFormError}" Background="#2A1618" BorderBrush="#7A3034"
                      BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                <TextBlock Text="{Binding FormError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
              </Border>
              <Button Classes="primary" Content="{Binding [onboard.restoreSubmit], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Margin="0,16,0,0"
                      IsEnabled="{Binding !IsBusy}" Command="{Binding ResetWithSeedCommand}"/>
              <Button Classes="ghost" Content="{Binding [onboard.backToUnlock], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Center" Margin="0,10,0,0"
                      FontSize="12" Command="{Binding CancelPasswordResetCommand}"/>
            </StackPanel>
          </StackPanel>

          <!-- Backup phrase (after create) -->
          <StackPanel IsVisible="{Binding IsBackupStage}" MaxWidth="640" Margin="24,44,24,24"
                      HorizontalAlignment="Center" Spacing="0">
            <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/secret.json"
                           Width="120" Height="120" HorizontalAlignment="Center" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
            <TextBlock Classes="serif" FontSize="30" Text="{Binding [onboard.backup], Source={x:Static app:Loc.Instance}}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <!-- Show the phrase (copyable), then gate the workspace behind a three-word confirmation. -->
            <StackPanel IsVisible="{Binding !PhraseVerifyStage}" Spacing="0">
              <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                         Text="{Binding [onboard.backupWarn], Source={x:Static app:Loc.Instance}}"/>

              <!-- Tap the phrase box itself to copy it (no separate button). -->
              <Button Command="{Binding CopyRecoveryPhraseCommand}" Cursor="Hand"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Margin="0,22,0,0"
                      Background="{DynamicResource UmBg}" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="12">
                <Button.Styles>
                  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource UmBg}"/>
                    <Setter Property="BorderBrush" Value="#9A7E3E"/>
                  </Style>
                </Button.Styles>
                <TextBlock Classes="mono" FontSize="16" LineHeight="30" TextWrapping="Wrap"
                           Text="{Binding RecoveryPhrase}"/>
              </Button>
              <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                         Text="{Binding [backup.copyHint], Source={x:Static app:Loc.Instance}}"/>

              <Border Background="#2A2418" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="10"
                      Padding="14" Margin="0,14,0,0">
                <TextBlock Foreground="#D9C99A" FontSize="12" TextWrapping="Wrap"
                           Text="{Binding [onboard.backupWarn2], Source={x:Static app:Loc.Instance}}"/>
              </Border>

              <Button Classes="primary" Content="{Binding [onboard.backupBtn], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Center"
                      Margin="0,22,0,0" Command="{Binding BeginPhraseVerifyCommand}"/>
            </StackPanel>

            <!-- Confirm the backup: type three of the words back, chosen at random each time. -->
            <StackPanel IsVisible="{Binding PhraseVerifyStage}" Spacing="0">
              <TextBlock Classes="serif" FontSize="20" HorizontalAlignment="Center" Margin="0,14,0,0"
                         Text="{Binding [backup.verifyTitle], Source={x:Static app:Loc.Instance}}"/>
              <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                         Text="{Binding [backup.verifySubtitle], Source={x:Static app:Loc.Instance}}"/>

              <StackPanel Spacing="10" Margin="0,18,0,0">
                <StackPanel Spacing="3">
                  <TextBlock Classes="eyebrow" Text="{Binding VerifyLabel1}"/>
                  <TextBox Text="{Binding VerifyWord1}" Watermark="…"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="eyebrow" Text="{Binding VerifyLabel2}"/>
                  <TextBox Text="{Binding VerifyWord2}" Watermark="…"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="eyebrow" Text="{Binding VerifyLabel3}"/>
                  <TextBox Text="{Binding VerifyWord3}" Watermark="…"/>
                </StackPanel>
              </StackPanel>

              <Border IsVisible="{Binding VerifyError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,14,0,0">
                <TextBlock Text="{Binding VerifyError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
              </Border>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,0">
                <Button Classes="ghost" Content="{Binding [backup.back], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding BackToPhraseCommand}"/>
                <Button Classes="primary" Content="{Binding [backup.verifyBtn], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding VerifyPhraseBackupCommand}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

        </Panel>
      </ScrollViewer>

      <!-- ============================ WORKSPACE (with sidebar) ============================ -->
      <DockPanel IsVisible="{Binding ShowSidebar}" LastChildFill="True">

        <!-- Navigation panel. Docked per the user's choice; tall on the sides, a compact
             bar on the top or bottom. -->
        <Border DockPanel.Dock="{Binding SidebarDock}" IsVisible="{Binding IsSidebarVertical}"
                Width="86" Background="{DynamicResource UmBgAlt}" BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">
            <!-- Default sidebar is just the theme colour (no photo). A user-chosen background still
                 works, with a scrim over it so the profile text and nav stay readable. -->
            <Image Grid.RowSpan="3" Source="{Binding SidebarBgImage}" Stretch="UniformToFill"
                   IsVisible="{Binding HasSidebarBg}" Opacity="0.30"/>
            <Border Grid.RowSpan="3" Background="#AB000000" IsVisible="{Binding HasSidebarBg}"/>

            <!-- Brand mark at the top (the same splash logo shown at launch), filling a square button —
                 no circle. Tap opens the wallet switcher; the wallet name shows as a tooltip. -->
            <Button Grid.Row="0" Classes="ghost" Padding="6" Margin="0,14,0,8" HorizontalAlignment="Center"
                    CornerRadius="16" Command="{Binding OpenWalletsCommand}" ToolTip.Tip="{Binding WalletLabel}">
              <Image Source="avares://Umbrella.Wallet.App/Assets/umbrellaLoadlogo.png"
                     Width="44" Height="44" Stretch="Uniform"/>
            </Button>

            <!-- Grouped nav capsule: a slightly-lifted rounded area (card colour on the panel) with
                 padding, icons only. Five sections (roadmap §6.1); Receive/Send live on the Wallet home. -->
            <Border Grid.Row="1" Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder}"
                    BorderThickness="1" CornerRadius="22" Margin="0,6" Padding="7,10"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Button Classes="navicon" Classes.active="{Binding IsWalletGroup}" Command="{Binding SelectSectionCommand}" CommandParameter="Portfolio"
                        AutomationProperties.Name="{Binding [nav.wallet], Source={x:Static app:Loc.Instance}}"
                        ToolTip.Tip="{Binding [nav.wallet], Source={x:Static app:Loc.Instance}}">
                  <Path Data="M4 11 L12 4 L20 11 M6 10 V19 H18 V10"/>
                </Button>
                <Button Classes="navicon" Classes.active="{Binding IsActivityGroup}" Command="{Binding SelectSectionCommand}" CommandParameter="Activity"
                        AutomationProperties.Name="{Binding [nav.activity], Source={x:Static app:Loc.Instance}}"
                        ToolTip.Tip="{Binding [nav.activity], Source={x:Static app:Loc.Instance}}">
                  <Path Data="M3 12 H7 L10 5 L14 19 L17 12 H21"/>
                </Button>
                <Button Classes="navicon" Classes.active="{Binding IsSwap}" Command="{Binding SelectSectionCommand}" CommandParameter="Swap"
                        AutomationProperties.Name="{Binding [nav.swap], Source={x:Static app:Loc.Instance}}"
                        ToolTip.Tip="{Binding [nav.swap], Source={x:Static app:Loc.Instance}}">
                  <Path Data="M6 8 H17 L14 5 M18 16 H7 L10 19"/>
                </Button>
                <Button Classes="navicon" Classes.active="{Binding IsDiscoverGroup}" Command="{Binding SelectSectionCommand}" CommandParameter="Discover"
                        AutomationProperties.Name="{Binding [nav.discover], Source={x:Static app:Loc.Instance}}"
                        ToolTip.Tip="{Binding [nav.discover], Source={x:Static app:Loc.Instance}}">
                  <Path Data="M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z"/>
                </Button>
                <Button Classes="navicon" Classes.active="{Binding IsSecurity}" Command="{Binding SelectSectionCommand}" CommandParameter="Security"
                        AutomationProperties.Name="{Binding [nav.security], Source={x:Static app:Loc.Instance}}"
                        ToolTip.Tip="{Binding [nav.security], Source={x:Static app:Loc.Instance}}">
                  <Path Data="M12 3 L20 6 V12 C20 16.4 16.6 19.7 12 21 C7.4 19.7 4 16.4 4 12 V6 Z"/>
                </Button>
                <Button Classes="navicon" Classes.active="{Binding IsSettings}" Command="{Binding SelectSectionCommand}" CommandParameter="Settings"
                        AutomationProperties.Name="{Binding [nav.settings], Source={x:Static app:Loc.Instance}}"
                        ToolTip.Tip="{Binding [nav.settings], Source={x:Static app:Loc.Instance}}">
                  <Path Data="M12 15 A3 3 0 1 0 12 9 A3 3 0 1 0 12 15 M12 3 V5 M12 19 V21 M3 12 H5 M19 12 H21 M6.2 6.2 L7.7 7.7 M16.3 16.3 L17.8 17.8 M17.8 6.2 L16.3 7.7 M7.7 16.3 L6.2 17.8"/>
                </Button>
              </StackPanel>
            </Border>

            <!-- Footer: lock action, icon only. -->
            <Button Grid.Row="2" Classes="navicon" Margin="0,6,0,16" HorizontalAlignment="Center"
                    Command="{Binding LockCommand}" AutomationProperties.Name="{Binding [footer.lock], Source={x:Static app:Loc.Instance}}"
 ToolTip.Tip="{Binding [footer.lock], Source={x:Static app:Loc.Instance}}">
              <Path Data="M7 11 V8 A5 5 0 0 1 17 8 V11 M5 11 H19 V20 H5 Z"/>
            </Button>
          </Grid>
        </Border>

        <!-- Content -->
        <!-- Compact horizontal navigation for the top/bottom placements. -->
        <Border DockPanel.Dock="{Binding SidebarDock}" IsVisible="{Binding IsDesktopHorizontalNav}"
                Background="{DynamicResource UmBgAlt}" BorderBrush="{DynamicResource UmBorder}"
                BorderThickness="0,1,0,1" Padding="14,8">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <!-- Wallet switcher — always reachable, so switching works when the nav is top/bottom. -->
            <Button Classes="chip" Command="{Binding OpenWalletsCommand}" IsVisible="{Binding IsUnlocked}"
                    AutomationProperties.Name="{Binding [settings.tabWallets], Source={x:Static app:Loc.Instance}}"
                    ToolTip.Tip="{Binding [settings.tabWallets], Source={x:Static app:Loc.Instance}}"
                    BorderBrush="{DynamicResource UmAccent}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="⇄" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ActiveWalletLabel}" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
            <Border Width="1" Background="{DynamicResource UmBorder}" Margin="2,4" IsVisible="{Binding IsUnlocked}"/>
            <Button Classes="chip" Content="{Binding [nav.wallet], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSectionCommand}" CommandParameter="Portfolio" Classes.active="{Binding IsWalletGroup}"/>
            <Button Classes="chip" Content="{Binding [nav.activity], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSectionCommand}" CommandParameter="Activity" Classes.active="{Binding IsActivityGroup}"/>
            <Button Classes="chip" Content="{Binding [nav.swap], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSectionCommand}" CommandParameter="Swap" Classes.active="{Binding IsSwap}"/>
            <Button Classes="chip" Content="{Binding [nav.discover], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSectionCommand}" CommandParameter="Discover" Classes.active="{Binding IsDiscoverGroup}"/>
            <Button Classes="chip" Content="{Binding [nav.security], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSectionCommand}" CommandParameter="Security" Classes.active="{Binding IsSecurity}"/>
            <Button Classes="chip" Content="{Binding [nav.settings], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSectionCommand}" CommandParameter="Settings" Classes.active="{Binding IsSettings}"/>
            <Button Classes="chip" Content="{Binding [nav.lock], Source={x:Static app:Loc.Instance}}" Command="{Binding LockCommand}"/>
          </StackPanel>
        </Border>

        <!-- ===== Mobile phone-style bottom tab bar: a floating rounded pill (Uniswap-style) with
             five fixed slots (no scrolling); overflow sections live in the "More" sheet. ===== -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsMobileNav}" Background="Transparent">
          <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder}" BorderThickness="1"
                  CornerRadius="24" Margin="12,6,12,12" Padding="8,4" HorizontalAlignment="Stretch"
                  BoxShadow="0 10 30 -10 #90000000">
          <UniformGrid Columns="5">
            <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Portfolio" Classes.active="{Binding IsPortfolio}">
              <StackPanel Spacing="3">
                <Path Classes="tabIcon" Data="M4 11 L12 4 L20 11 M6 10 V20 H18 V10"/>
                <TextBlock Text="{Binding [nav.portfolio], Source={x:Static app:Loc.Instance}}" FontSize="9" HorizontalAlignment="Center" MaxWidth="66" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
            <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Receive" Classes.active="{Binding IsReceive}">
              <StackPanel Spacing="3">
                <Path Classes="tabIcon" Data="M12 3 V17 M12 17 L6 11 M12 17 L18 11 M4 21 H20"/>
                <TextBlock Text="{Binding [nav.receive], Source={x:Static app:Loc.Instance}}" FontSize="9" HorizontalAlignment="Center" MaxWidth="66" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
            <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Send" Classes.active="{Binding IsSend}">
              <StackPanel Spacing="3">
                <Path Classes="tabIcon" Data="M12 21 V7 M12 7 L6 13 M12 7 L18 13 M4 3 H20"/>
                <TextBlock Text="{Binding [nav.send], Source={x:Static app:Loc.Instance}}" FontSize="9" HorizontalAlignment="Center" MaxWidth="66" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
            <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Market" Classes.active="{Binding IsMarket}">
              <StackPanel Spacing="3">
                <Path Classes="tabIcon" Data="M4 19 H20 M4 19 V5 M7 15 L11 10 L14 13 L19 6"/>
                <TextBlock Text="{Binding [nav.market], Source={x:Static app:Loc.Instance}}" FontSize="9" HorizontalAlignment="Center" MaxWidth="66" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
            <Button Classes="tab" Command="{Binding ToggleMoreSheetCommand}" Classes.active="{Binding IsMoreSheetOpen}">
              <StackPanel Spacing="3">
                <Path Classes="tabIcon" Data="M5 12 H5.01 M12 12 H12.01 M19 12 H19.01"/>
                <TextBlock Text="{Binding [nav.more], Source={x:Static app:Loc.Instance}}" FontSize="9" HorizontalAlignment="Center" MaxWidth="66" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
          </UniformGrid>
          </Border>
        </Border>

        <Grid RowDefinitions="*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <!-- Padding lives on the content, NOT the ScrollViewer. With horizontal scrolling
               disabled Avalonia measures content at the full viewport width and only then
               insets it by the ScrollViewer's padding, so the right edge overflowed by exactly
               that padding — which is what clipped the Receive QR card. A margin is measured. -->
          <ScrollViewer Grid.Column="0" AllowAutoHide="True"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <!-- Cap the content column and CENTRE it, so a full-screen or large window doesn't
                 stretch the tiles and tables edge-to-edge and doesn't sit lopsided against the left
                 either — it reads as one tidy, balanced column at any size. -->
            <!-- Right margin is a touch wider than the left so the floating vertical scrollbar never
                 sits over a card's right edge (which clipped rows on Activity). -->
            <StackPanel Spacing="24" Margin="34,32,38,88" MaxWidth="{Binding ContentMaxWidth}" HorizontalAlignment="Center">

              <!-- Portfolio -->
              <StackPanel Classes="page" IsVisible="{Binding IsPortfolio}" Spacing="18">
                <!-- Top row: the balance card on the left, a 2×2 grid of live stat tiles filling the
                     space to its right so the dashboard reads full and balanced rather than a lone card. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                <!-- Cinematic balance hero: the generated backdrop, with the balance overlaid on the
                     left and the brand mark over the 'portal' on the right. -->
                <!-- Balance as a credit-card-sized card (≈1.6:1), left-aligned — not stretched full width. -->
                <Border CornerRadius="22" ClipToBounds="True" Width="392" Height="266" HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource UmBorder}"
                        BorderThickness="1" BoxShadow="0 16 44 -16 #80000000"
                        PointerMoved="OnHeroPointerMoved" PointerExited="OnHeroPointerExited">
                  <Panel>
                    <!-- ANIMATED (default): a deep-navy base with rain footage composited over it. The
                         frames are keyed to alpha, so only the silver streaks show over the navy — no
                         darkening. Shown when the portfolio-video toggle and master motion are both on. -->
                    <Border Background="{DynamicResource UmHeroGradient}" IsVisible="{Binding PortfolioVideoOn}"/>
                    <Border Background="{DynamicResource UmAccentWash}" IsVisible="{Binding PortfolioVideoOn}"/>
                    <controls:FrameAnimation Opacity="0.6" Margin="-1" IsVisible="{Binding PortfolioVideoOn}"/>

                    <!-- STILL (motion off): the same clean navy hero gradient as the animated base, just
                         without the rain. No photo — the old photo backdrop blew out to bright white at
                         the card edges, which looked broken with motion off. -->
                    <Border Background="{DynamicResource UmHeroGradient}" IsVisible="{Binding !PortfolioVideoOn}"/>
                    <Border Background="{DynamicResource UmAccentWash}" IsVisible="{Binding !PortfolioVideoOn}"/>

                    <!-- Bottom-left vignette so the balance always reads cleanly over either backdrop. -->
                    <Border>
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,100%" EndPoint="65%,10%">
                          <GradientStop Color="#B3060B14" Offset="0"/>
                          <GradientStop Color="#00060B14" Offset="0.9"/>
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <!-- Logo to the right, vertically centred — balance sits bottom-left, so the mark
                         reads as the card's brand without covering the numbers. -->
                    <Image Source="{Binding LogoImage}" Width="96" Height="96" Opacity="0.96"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,48,0"/>
                    <Grid Margin="30,22">
                      <!-- Balance anchored bottom-left so it never collides with the centred logo. -->
                      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Classes="eyebrow" Text="{Binding TotalBalanceCaption}" VerticalAlignment="Center"/>
                          <Button Classes="chip" Content="{Binding HideBalanceLabel}" Command="{Binding ToggleBalanceHiddenCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="serif" FontSize="30" Foreground="{DynamicResource UmAccentBright}" Text="{Binding CurrencySymbol}" Margin="0,0,4,7" VerticalAlignment="Bottom"/>
                          <TextBlock Classes="serif" FontSize="54" FontWeight="Medium" Text="{Binding BalanceDisplayMain}" VerticalAlignment="Bottom" LineHeight="58"/>
                          <TextBlock Classes="serif" FontSize="26" Foreground="{DynamicResource UmTextDim}" Text="{Binding BalanceDisplayCents}"
                                     VerticalAlignment="Bottom" Margin="1,0,0,7"/>
                        </StackPanel>
                        <Border Background="{Binding PortfolioChangeColor, Converter={StaticResource ChangeWash}}"
                                CornerRadius="999" Padding="9,4" HorizontalAlignment="Left" Margin="0,2,0,0">
                          <TextBlock Text="{Binding Change24hLabel}" Foreground="{Binding PortfolioChangeColor}" FontSize="12.5" FontWeight="SemiBold"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Panel>
                </Border>

                <!-- Beside the balance card: two DIFFERENT widget types (not four number clones) —
                     a live "Top movers" list and a horizontal allocation bar — so the dashboard reads
                     like a real board of distinct modules. -->
                <Grid Grid.Column="1" RowDefinitions="*,Auto">
                  <!-- Widget 1 · Top movers (a market list) -->
                  <Border Classes="card" Padding="16,13">
                    <StackPanel Spacing="9">
                      <!-- The localized title already names the period ("Top gainers (24h)"); the old
                           right-aligned "24H" badge repeated it, and in hardcoded English at that. -->
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"
                                 Text="{Binding [market.gainers], Source={x:Static app:Loc.Instance}}"/>
                      <ItemsControl ItemsSource="{Binding MarketGainers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MarketRowViewModel">
                            <Button Classes="row" CornerRadius="10" Padding="6,5" Margin="0,1" MinHeight="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).SelectMarketCoinCommand}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="26" Height="26" CornerRadius="13" Background="{Binding BadgeBg}" ClipToBounds="True" VerticalAlignment="Center">
                                  <Panel>
                                    <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" FontSize="12.5" FontWeight="Bold"
                                               Foreground="#FFFFFF" Text="{Binding BadgeGlyph}" IsVisible="{Binding !HasBadgeLogo}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                                  </Panel>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="12.5"
                                           Margin="9,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ChangeLabel}" Foreground="{Binding ChangeColor}"
                                           FontSize="12" FontWeight="SemiBold" Classes="mono" VerticalAlignment="Center"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- Widget 2 · Allocation bar (a chart) with an asset/network footer -->
                  <Border Grid.Row="1" Classes="card" Padding="16,13" Margin="0,14,0,0">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding [portfolio.allocation], Source={x:Static app:Loc.Instance}}"/>
                      <!-- Segmented allocation bar (empty prompt until there are funds). -->
                      <Border Height="12" CornerRadius="6" Background="{DynamicResource UmInput}" ClipToBounds="True"
                              IsVisible="{Binding HasBreakdown}">
                        <ItemsControl ItemsSource="{Binding PortfolioBreakdown}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PortfolioSlice">
                              <Border Width="{Binding BarWidth}" Background="{Binding Brush}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                      <TextBlock FontSize="11" Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"
                                 IsVisible="{Binding !HasBreakdown}"
                                 Text="{Binding [portfolio.overviewEmpty], Source={x:Static app:Loc.Instance}}"/>
                      <!-- Asset + network counts, inline (not their own tiles). -->
                      <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding PortfolioAssetCount}" FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock Text="{Binding [stat.assets], Source={x:Static app:Loc.Instance}}"
                                     FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding PortfolioNetworkCount}" FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock Text="{Binding [stat.networks], Source={x:Static app:Loc.Instance}}"
                                     FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>
                </Grid>

                <!-- Quick actions, Kraken-style: round accent discs with a label under each, so the
                     primary things you do with a wallet read at a glance instead of as blank squares. -->
                <StackPanel Orientation="Horizontal" Spacing="26" HorizontalAlignment="Left" Margin="4,4,0,0">
                  <Button Classes="action" Command="{Binding SelectSectionCommand}" CommandParameter="Receive"
                          AutomationProperties.Name="{Binding [nav.receive], Source={x:Static app:Loc.Instance}}">
                    <StackPanel>
                      <Border Classes="disc">
                        <Path Classes="actionIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12 3 V17 M12 17 L6 11 M12 17 L18 11 M4 21 H20"/>
                      </Border>
                      <TextBlock Classes="actionLabel" Text="{Binding [nav.receive], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="action" Command="{Binding SelectSectionCommand}" CommandParameter="Send"
                          AutomationProperties.Name="{Binding [nav.send], Source={x:Static app:Loc.Instance}}">
                    <StackPanel>
                      <Border Classes="disc">
                        <Path Classes="actionIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12 21 V7 M12 7 L6 13 M12 7 L18 13 M4 3 H20"/>
                      </Border>
                      <TextBlock Classes="actionLabel" Text="{Binding [nav.send], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="action" Command="{Binding SelectSectionCommand}" CommandParameter="Swap"
                          AutomationProperties.Name="{Binding [nav.swap], Source={x:Static app:Loc.Instance}}">
                    <StackPanel>
                      <Border Classes="disc">
                        <Path Classes="actionIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M6 8 H17 L14 5 M18 16 H7 L10 19"/>
                      </Border>
                      <TextBlock Classes="actionLabel" Text="{Binding [nav.swap], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="action" Command="{Binding SelectSectionCommand}" CommandParameter="Buy"
                          AutomationProperties.Name="{Binding [section.buyCrypto], Source={x:Static app:Loc.Instance}}">
                    <StackPanel>
                      <Border Classes="disc">
                        <Path Classes="actionIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12 5 V19 M5 12 H19"/>
                      </Border>
                      <TextBlock Classes="actionLabel" Text="{Binding [section.buyCrypto], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="action" Command="{Binding SelectSectionCommand}" CommandParameter="Market"
                          AutomationProperties.Name="{Binding [nav.market], Source={x:Static app:Loc.Instance}}">
                    <StackPanel>
                      <Border Classes="disc">
                        <Path Classes="actionIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M4 19 H20 M4 19 V5 M7 15 L11 10 L14 13 L19 6"/>
                      </Border>
                      <TextBlock Classes="actionLabel" Text="{Binding [nav.market], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="4" Height="24" CornerRadius="2" Background="{DynamicResource UmAccentBright}"/>
                    <TextBlock Classes="serif" FontSize="26" Text="{Binding [common.holdings], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Border Grid.Column="1" Classes="hairline" Padding="4">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button Classes="chip" Content="{Binding [filter.all], Source={x:Static app:Loc.Instance}}" Command="{Binding SetChainFilterCommand}" CommandParameter="All"
                              Classes.active="{Binding ChainFilter, Converter={StaticResource StringEquals}, ConverterParameter=All}"/>
                      <Button Classes="chip" Content="Bitcoin" Command="{Binding SetChainFilterCommand}" CommandParameter="Bitcoin"
                              Classes.active="{Binding ChainFilter, Converter={StaticResource StringEquals}, ConverterParameter=Bitcoin}"/>
                      <Button Classes="chip" Content="Ethereum" Command="{Binding SetChainFilterCommand}" CommandParameter="Ethereum"
                              Classes.active="{Binding ChainFilter, Converter={StaticResource StringEquals}, ConverterParameter=Ethereum}"/>
                      <Button Classes="chip" Content="Solana" Command="{Binding SetChainFilterCommand}" CommandParameter="Solana"
                              Classes.active="{Binding ChainFilter, Converter={StaticResource StringEquals}, ConverterParameter=Solana}"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Sort the holdings: biggest value, best 24h mover, or by ticker. Clicking the active
                     chip returns the list to its catalog order. -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,2,0,0">
                  <TextBlock Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,4,0"
                             Text="{Binding [sort.label], Source={x:Static app:Loc.Instance}}"/>
                  <Button Classes="chip" Content="{Binding [sort.value], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding SetHoldingsSortCommand}" CommandParameter="Value"
                          Classes.active="{Binding HoldingsSort, Converter={StaticResource StringEquals}, ConverterParameter=Value}"/>
                  <Button Classes="chip" Content="{Binding [sort.change], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding SetHoldingsSortCommand}" CommandParameter="Change"
                          Classes.active="{Binding HoldingsSort, Converter={StaticResource StringEquals}, ConverterParameter=Change}"/>
                  <Button Classes="chip" Content="{Binding [sort.name], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding SetHoldingsSortCommand}" CommandParameter="Name"
                          Classes.active="{Binding HoldingsSort, Converter={StaticResource StringEquals}, ConverterParameter=Name}"/>
                </StackPanel>

                <!-- Suspected spam airdrops. They are folded away, never deleted, and the count is
                     always visible — a wallet must not quietly decide that something you hold does not
                     exist. The warning explains WHY they are hidden, because the name is the attack. -->
                <Border IsVisible="{Binding HasSpamTokens}" Margin="0,2,0,0"
                        Background="{DynamicResource UmCardAlt}" BorderBrush="#7A6230" BorderThickness="1"
                        CornerRadius="10" Padding="12,9">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding SpamTokenNotice}"/>
                      <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UmTextDim}"
                                 Text="{Binding [spam.warn], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" MinHeight="0" Padding="10,5" FontSize="11"
                            VerticalAlignment="Center"
                            Content="{Binding SpamToggleLabel}" Command="{Binding ToggleSpamTokensCommand}"/>
                  </Grid>
                </Border>

                <!-- Holdings as clean rows (no column-header table): coin mark + name/ticker on the left,
                     fiat value over the coin amount on the right, and a tinted 24h pill. The whole row
                     opens that coin's asset page. Rows scroll inside a fixed height so the list never
                     eats the page. -->
                <Border Classes="card" Padding="6">
                  <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Holdings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HoldingRowViewModel">
                          <Button Classes="row" CornerRadius="14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).OpenAssetDetailsCommand}"
                                  CommandParameter="{Binding Symbol}"
                                  AutomationProperties.Name="{Binding Name}">
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="64" Margin="14,0">
                              <!-- Coin mark -->
                              <Border Width="42" Height="42" CornerRadius="21" Background="{Binding BadgeBg}"
                                      BoxShadow="{Binding BadgeShadow}" ClipToBounds="True" VerticalAlignment="Center">
                                <Panel>
                                  <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" FontSize="19" FontWeight="Bold"
                                             Foreground="#FFFFFF" Text="{Binding BadgeGlyph}" IsVisible="{Binding !HasBadgeLogo}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                                </Panel>
                              </Border>
                              <!-- Name + network subtitle -->
                              <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2" ClipToBounds="True">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <TextBlock Text="{Binding Symbol}" FontSize="12" Foreground="{DynamicResource UmTextMuted}"/>
                                  <Border Background="{Binding ChangeColor, Converter={StaticResource ChangeWash}}"
                                          CornerRadius="999" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChangeLabel}" Foreground="{Binding ChangeColor}" FontSize="10.5" FontWeight="SemiBold"/>
                                  </Border>
                                </StackPanel>
                              </StackPanel>
                              <!-- Value over amount -->
                              <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="3">
                                <TextBlock Classes="mono" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Text="{Binding ValueLabel}"
                                           IsVisible="{Binding #RootWindow.((vm:MainViewModel)DataContext).AreValuesVisible}"/>
                                <TextBlock Classes="mono" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Right" Text="••••"
                                           IsVisible="{Binding #RootWindow.((vm:MainViewModel)DataContext).IsBalanceHidden}"/>
                                <TextBlock Classes="mono" FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" HorizontalAlignment="Right"
                                           Text="{Binding AmountLabel}" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding #RootWindow.((vm:MainViewModel)DataContext).AreValuesVisible}"/>
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </StackPanel>

              <!-- Receive. DockPanel rather than a star Grid on purpose: a 95-char Monero
                   address reports a desired width far wider than any star share, which pushed
                   the QR card off the right edge. DockPanel sizes the docked QR card first and
                   hands the list exactly what remains, so it can never overflow. -->
              <!-- Receive: full-width list. The QR now opens as a centred popup (see the
                   overlay at the end of this file) instead of a cramped side panel. -->
              <StackPanel Classes="page" IsVisible="{Binding IsReceive}" Spacing="12" MinWidth="0" ClipToBounds="True">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center"
                               Text="{Binding [receive.title], Source={x:Static app:Loc.Instance}}"/>
                    <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/Recieve.json" Width="46" Height="46" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" FontSize="12.5"
                             Text="{Binding [sec.receiveDesc], Source={x:Static app:Loc.Instance}}"/>
                  <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WalletAccountViewModel">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,8" Padding="12" IsEnabled="{Binding IsReady}"
                                AutomationProperties.Name="{Binding Name}"
                                Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).SelectReceiveAccountCommand}"
                                CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,56,*,Auto">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding StatusColor}"/>
                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="{Binding BadgeBg}" Margin="12,0,0,0" ClipToBounds="True">
                              <Panel>
                                <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="#FFFFFF" Text="{Binding BadgeGlyph}" IsVisible="{Binding !HasBadgeLogo}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                              </Panel>
                            </Border>
                            <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center"
                                        MinWidth="0" ClipToBounds="True">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock FontSize="10.5" Foreground="{DynamicResource UmTextMuted}" Text="{Binding NetworkLabel}"
                                         TextTrimming="CharacterEllipsis"/>
                              <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource UmTextDim}" Margin="0,2,0,0"
                                         Text="{Binding Address}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
              </StackPanel>

              <!-- Send -->
              <StackPanel Classes="page" IsVisible="{Binding IsSend}" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center" Text="{Binding [send.title], Source={x:Static app:Loc.Instance}}"/>
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-08.json" Width="42" Height="42" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" FontSize="12.5"
                           Text="{Binding [sec.sendDesc], Source={x:Static app:Loc.Instance}}"/>

                <!-- Step 1 · what & where -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="{Binding [send.step1], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Classes="eyebrow" Text="{Binding [col.asset], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding SendableAssets}"
                              SelectedItem="{Binding SelectedSendAsset}"
                              HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SendOption">
                          <StackPanel Spacing="1" Margin="0,3">
                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Network}" FontSize="10.5" Foreground="{DynamicResource UmTextDim}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="eyebrow" Text="{Binding [send.destLabel], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding SendTo}" Watermark="{Binding [send.destPlaceholder], Source={x:Static app:Loc.Instance}}"/>

                    <!-- Network-check-on-paste: advisory only, but flags a destination that doesn't look
                         like the selected network before any funds move. -->
                    <Border IsVisible="{Binding SendAddressWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#2A2416" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="8" Padding="12,9">
                      <!-- Grid (Auto icon, * text) so a long warning wraps inside the card instead of
                           running off the right edge. -->
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="⚠" Foreground="#E7CA83" VerticalAlignment="Top" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding SendAddressWarning}" Foreground="#D8C79A"
                                   TextWrapping="Wrap" FontSize="11.5"/>
                      </Grid>
                    </Border>

                    <!-- Positive trust signal: the destination is a saved contact or one you've paid
                         before. Green, so a trusted address reads as safe at a glance. -->
                    <Border IsVisible="{Binding SendKnownContactShown}" CornerRadius="8" Padding="12,8"
                            Background="#1622C55E" BorderThickness="1" BorderBrush="#2F7D53">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="✓" Foreground="#7DCF8F" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SendKnownContact}" Foreground="#9FE0B1" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>

                    <!-- Scam control: address-poisoning / own-address warning. The lookalike case is
                         red (a likely scam); the own-address case is amber (a caution). Advisory. -->
                    <Border IsVisible="{Binding SendSafetyShown}" CornerRadius="10" Padding="12,10"
                            Background="#22000000" BorderThickness="1" BorderBrush="{Binding SendSafetyColor}">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="⚠" Foreground="{Binding SendSafetyColor}" FontSize="13" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding SendSafetyTitle}" Foreground="{Binding SendSafetyColor}"
                                     FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SendSafetyText}" Foreground="{DynamicResource UmTextDim}"
                                   FontSize="11.5" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <!-- Local address book: save this destination, or reuse a saved one for this asset. -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding SendAddressLabel}"
                               Watermark="{Binding [send.addrLabel], Source={x:Static app:Loc.Instance}}"/>
                      <Button Grid.Column="1" Classes="ghost" MinHeight="0" Padding="14,8" VerticalAlignment="Stretch"
                              Content="{Binding [send.addrSave], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding SaveSendAddressCommand}"/>
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding HasSendAddressBook}">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding [send.addrSaved], Source={x:Static app:Loc.Instance}}"/>
                      <ItemsControl ItemsSource="{Binding SendAddressBook}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="app:AddressBookEntry">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                              <Button Grid.Column="0" Classes="ghost" MinHeight="0" Padding="10,6"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                      ToolTip.Tip="{Binding Address}"
                                      Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).UseSendAddressCommand}"
                                      CommandParameter="{Binding}">
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                                  <TextBlock Classes="mono" FontSize="10.5" Foreground="{DynamicResource UmTextMuted}"
                                             Text="{Binding Address}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                              </Button>
                              <Button Grid.Column="1" Classes="chip" Content="✕" VerticalAlignment="Center" Margin="6,0,0,0"
                                      AutomationProperties.Name="{Binding [common.remove], Source={x:Static app:Loc.Instance}}"
                                      Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).RemoveSendAddressCommand}"
                                      CommandParameter="{Binding}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="eyebrow" VerticalAlignment="Center"
                                 Text="{Binding [send.amount], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"
                                 Text="{Binding SelectedSendBalanceLabel}"/>
                    </Grid>
                    <!-- Fiat quick-entry: type a USD amount and the coin amount fills in below. Shown only
                         when the asset is priced. The coin field stays the authoritative value that is
                         signed — this only fills it in, so the user always confirms the coin amount. -->
                    <StackPanel Spacing="3" Margin="0,2,0,0" IsVisible="{Binding FiatInputAvailable}">
                      <TextBox Text="{Binding SendFiatAmount}"
                               Watermark="{Binding [send.fiatPlaceholder], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" Margin="2,0,0,0"
                                 IsVisible="{Binding SendFiatCoinEquiv, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Text="{Binding SendFiatCoinEquiv}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding SendAmount}" Watermark="0.0"/>
                      <!-- Quick amount presets: a share of the balance (25% / 50%) plus the fee-aware Max. -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="ghost" MinHeight="0" Padding="12,10" VerticalAlignment="Stretch"
                                Content="25%" Command="{Binding SetAmountPercentCommand}" CommandParameter="25"/>
                        <Button Classes="ghost" MinHeight="0" Padding="12,10" VerticalAlignment="Stretch"
                                Content="50%" Command="{Binding SetAmountPercentCommand}" CommandParameter="50"/>
                        <Button Classes="ghost" MinHeight="0" Padding="16,10" VerticalAlignment="Stretch"
                                Content="{Binding [send.max], Source={x:Static app:Loc.Instance}}" Command="{Binding SetMaxAmountCommand}"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" Margin="2,0,0,0"
                               IsVisible="{Binding SendAmountFiat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding SendAmountFiat}"/>

                    <!-- Coin control (§3.4): opt-in manual UTXO selection for BTC/LTC/DOGE. Off = automatic
                         selection (unchanged). On = only the ticked coins may fund the spend, so a payment
                         never publicly links coins that belong to a different identity. -->
                    <Border IsVisible="{Binding CoinControlAvailable}"
                            Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                       Text="{Binding [send.coinControl], Source={x:Static app:Loc.Instance}}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource UmTextDim}"
                                       Text="{Binding [send.coinControlHint], Source={x:Static app:Loc.Instance}}"/>
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                        IsChecked="{Binding CoinControlOn}"/>
                        </Grid>

                        <StackPanel Spacing="8" IsVisible="{Binding CoinControlOn}">
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource UmTextDim}" Text="{Binding CoinControlSummary}"/>
                            <Button Grid.Column="1" Classes="ghost" MinHeight="0" Padding="10,5" FontSize="11"
                                    Content="{Binding [send.coinAll], Source={x:Static app:Loc.Instance}}"
                                    Command="{Binding CoinControlSelectAllCommand}"/>
                            <Button Grid.Column="2" Classes="ghost" MinHeight="0" Padding="10,5" FontSize="11"
                                    Content="{Binding [send.coinNone], Source={x:Static app:Loc.Instance}}"
                                    Command="{Binding CoinControlSelectNoneCommand}"/>
                          </Grid>

                          <TextBlock Text="{Binding [send.coinLoading], Source={x:Static app:Loc.Instance}}"
                                     FontSize="11" Foreground="{DynamicResource UmTextDim}"
                                     IsVisible="{Binding CoinControlLoading}"/>

                          <ScrollViewer MaxHeight="188" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding CoinControlUtxos}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CoinControlUtxoVm">
                                  <Border Background="{DynamicResource UmCard}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                      <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Amount}" FontWeight="SemiBold" FontSize="12.5" Classes="mono"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                          <Border Background="{DynamicResource UmAccentWash}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource ActivityLabel}}" FontSize="9.5" Foreground="{DynamicResource UmAccentText}"/>
                                          </Border>
                                          <TextBlock Text="{Binding AddressShort}" FontSize="10.5" Classes="mono"
                                                     Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                      </StackPanel>
                                      <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource UmTextMuted}"/>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- Network fee speed (UTXO chains): Economy / Standard / Priority. Standard is the
                         economical rate the wallet has always used, so an untouched selector never changes
                         the fee; only the sat/vB fed to the planner changes, and every level stays inside
                         the chain's safe fee band (never below the relay floor). The signing path is
                         unaffected. Changing it after a quote is shown re-prices it. -->
                    <Border IsVisible="{Binding FeeLevelAvailable}"
                            Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                      <StackPanel Spacing="8">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding [fee.title], Source={x:Static app:Loc.Instance}}"
                                     FontSize="12.5" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding [fee.hint], Source={x:Static app:Loc.Instance}}"
                                     FontSize="11" Foreground="{DynamicResource UmTextDim}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                          <RadioButton GroupName="feeLevel" IsChecked="{Binding IsFeeEconomy, Mode=OneWay}"
                                       Command="{Binding SetFeeLevelCommand}" CommandParameter="0"
                                       Content="{Binding [fee.economy], Source={x:Static app:Loc.Instance}}"/>
                          <RadioButton GroupName="feeLevel" IsChecked="{Binding IsFeeStandard, Mode=OneWay}"
                                       Command="{Binding SetFeeLevelCommand}" CommandParameter="1"
                                       Content="{Binding [fee.standard], Source={x:Static app:Loc.Instance}}"/>
                          <RadioButton GroupName="feeLevel" IsChecked="{Binding IsFeePriority, Mode=OneWay}"
                                       Command="{Binding SetFeeLevelCommand}" CommandParameter="2"
                                       Content="{Binding [fee.priority], Source={x:Static app:Loc.Instance}}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding SendError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="6" Padding="12,9">
                      <TextBlock Text="{Binding SendError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <Button Classes="primary" Content="{Binding [send.review], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                            IsEnabled="{Binding !IsBusy}" Command="{Binding PrepareSendCommand}"/>
                  </StackPanel>
                </Border>

                <!-- Step 2 · review & confirm. Financially transparent (§4): the full destination is
                     always visible (never truncated), the amount carries its fiat value, and the total
                     debit reads separately from the network fee. -->
                <Border Classes="card" BorderBrush="#7A6230" IsVisible="{Binding HasSendQuote}">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [send.step2], Source={x:Static app:Loc.Instance}}"/>

                    <!-- Amount + fiat -->
                    <StackPanel Spacing="2">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}" Text="{Binding [send.amount], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Classes="mono" FontSize="15" FontWeight="SemiBold" Text="{Binding SendReviewAmount}"/>
                      <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}"
                                 IsVisible="{Binding SendReviewFiat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Text="{Binding SendReviewFiat}"/>
                    </StackPanel>

                    <!-- Full destination — selectable, wraps, never shortened (verify every character). -->
                    <StackPanel Spacing="2">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}" Text="{Binding [send.destLabel], Source={x:Static app:Loc.Instance}}"/>
                      <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1"
                              CornerRadius="8" Padding="10,8">
                        <SelectableTextBlock Classes="mono" FontSize="12" TextWrapping="Wrap"
                                             Foreground="{DynamicResource UmTextSoft}" Text="{Binding SendReviewTo}"/>
                      </Border>
                    </StackPanel>

                    <!-- Network fee (kept as its own line, separate from the total debit below). -->
                    <StackPanel Spacing="2">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}" Text="{Binding [send.networkFee], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Classes="mono" FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" Text="{Binding SendQuoteFee}"/>
                    </StackPanel>

                    <!-- Total debit — what actually leaves the wallet, stated apart from the fee. -->
                    <Border Background="#1E1A12" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="8" Padding="10,8">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [send.totalDebit], Source={x:Static app:Loc.Instance}}"/>
                        <TextBlock FontSize="12" Foreground="#D8C79A" TextWrapping="Wrap" Text="{Binding SendReviewDebit}"/>
                      </StackPanel>
                    </Border>

                    <!-- Privacy Radar (local, offline): how this send affects YOUR on-chain privacy —
                         chain analysis FOR the user. Shown for UTXO chains, where linking inputs matters. -->
                    <Border IsVisible="{Binding HasSendPrivacy}" CornerRadius="8" Padding="12,10"
                            Background="#22000000" BorderThickness="1" BorderBrush="{Binding SendPrivacyColor}">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="🛡" FontSize="13" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding [priv.title], Source={x:Static app:Loc.Instance}}"
                                     Classes="eyebrow" VerticalAlignment="Center"
                                     Foreground="{Binding SendPrivacyColor}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SendPrivacyHeadline}" Foreground="{Binding SendPrivacyColor}"
                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding SendPrivacyFindings}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SendPrivacyFindingVm">
                              <Grid ColumnDefinitions="Auto,*" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Spacing="1">
                                  <TextBlock Text="{Binding Title}" Foreground="{Binding Color}"
                                             FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource UmTextDim}"
                                             FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <TextBlock Foreground="#BBAF91" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [send.step2warn], Source={x:Static app:Loc.Instance}}"/>

                    <!-- Anonymity reminder: broadcasting with Tor off exposes your IP to the node. Only
                         shown when clearnet is actually possible (Tor off and kill-switch off). -->
                    <Border IsVisible="{Binding ShowSendClearnetNote}" CornerRadius="8" Padding="12,9"
                            Background="#22000000" BorderThickness="1" BorderBrush="#7A6230">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="🧅" VerticalAlignment="Top" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding [send.clearnetNote], Source={x:Static app:Loc.Instance}}"
                                   Foreground="{DynamicResource UmTextDim}" FontSize="11.5" TextWrapping="Wrap"/>
                      </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="danger" Content="{Binding [send.confirm], Source={x:Static app:Loc.Instance}}" IsEnabled="{Binding !IsBusy}"
                              Command="{Binding ConfirmSendCommand}"/>
                      <Button Classes="ghost" Content="{Binding [common.cancel], Source={x:Static app:Loc.Instance}}" Command="{Binding CancelSendQuoteCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Broadcasting animation -->
                <Border Classes="card" IsVisible="{Binding IsBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/Sending.json"
                                   Width="72" Height="72" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource UmTextDim}" FontSize="12.5"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Result -->
                <Border Background="#14231A" BorderBrush="#2F5A3C" BorderThickness="1" CornerRadius="10" Padding="14"
                        IsVisible="{Binding SendSuccess, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/money.json"
                                   Width="56" Height="56" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Top"/>
                    <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource UmPos}" TextWrapping="Wrap"
                               Text="{Binding SendSuccess}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Swap (THORChain · non-custodial cross-chain) -->
              <StackPanel Classes="page" IsVisible="{Binding IsSwap}" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center" Text="{Binding [nav.swap], Source={x:Static app:Loc.Instance}}"/>
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-08.json" Width="42" Height="42" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" FontSize="12.5"
                           Text="{Binding [swap.desc], Source={x:Static app:Loc.Instance}}"/>

                <!-- Honest coverage note: which chains the non-custodial route reaches, and what to do
                     for the rest, so "why can't I swap X?" is answered on the screen itself. -->
                <Border Background="{DynamicResource UmCardAlt}" CornerRadius="10" Padding="12,9">
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"
                             Text="{Binding [swap.coverage], Source={x:Static app:Loc.Instance}}"/>
                </Border>

                <!-- Step 1 · pair & amount. A DEX-style stacked "You pay → You receive" widget with a
                     circular flip button straddling the two panels, like Uniswap. -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="{Binding [swap.step1], Source={x:Static app:Loc.Instance}}"/>

                    <Grid RowDefinitions="Auto,Auto">
                      <!-- You pay -->
                      <Border Background="{DynamicResource UmInput}" BorderBrush="{DynamicResource UmBorder2}"
                              BorderThickness="1" CornerRadius="16" Padding="16,13">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                                       Text="{Binding [swap.from], Source={x:Static app:Loc.Instance}}"/>
                            <TextBox Text="{Binding SwapAmount}" Watermark="0.0" BorderThickness="0" Padding="0"
                                     MinHeight="0" Background="Transparent" FontSize="26" FontWeight="SemiBold"/>
                          </StackPanel>
                          <ComboBox Grid.Column="1" MinWidth="118" VerticalAlignment="Center"
                                    ItemsSource="{Binding SwapFromOptions}" SelectedItem="{Binding SwapFromSymbol}"/>
                        </Grid>
                      </Border>

                      <!-- Flip button, overlapping the seam between the two panels. -->
                      <Border Grid.Row="0" Grid.RowSpan="2" Width="42" Height="42" CornerRadius="21"
                              HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="2"
                              Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder3}" BorderThickness="2">
                        <Button Classes="action" Command="{Binding FlipSwapCommand}"
                                AutomationProperties.Name="{Binding [swap.from], Source={x:Static app:Loc.Instance}}"
                                Width="42" Height="42">
                          <Path Stroke="{DynamicResource UmAccentBright}" StrokeThickness="2" StrokeLineCap="Round"
                                StrokeJoin="Round" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Data="M8 4 V16 M8 16 L5 13 M8 16 L11 13 M16 20 V8 M16 8 L13 11 M16 8 L19 11"/>
                        </Button>
                      </Border>

                      <!-- You receive -->
                      <Border Grid.Row="1" Margin="0,8,0,0" Background="{DynamicResource UmInput}"
                              BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1" CornerRadius="16" Padding="16,13">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                                       Text="{Binding [swap.to], Source={x:Static app:Loc.Instance}}"/>
                            <TextBlock Text="{Binding SwapExpectedOut}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource UmTextDim}" Classes="mono"
                                       IsVisible="{Binding SwapExpectedOut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="≈ 0.0" FontSize="24" FontWeight="SemiBold" Classes="mono"
                                       Foreground="{DynamicResource UmTextMuted}"
                                       IsVisible="{Binding !HasSwapQuote}"/>
                          </StackPanel>
                          <ComboBox Grid.Column="1" MinWidth="118" VerticalAlignment="Center"
                                    ItemsSource="{Binding SwapToOptions}" SelectedItem="{Binding SwapToSymbol}"/>
                        </Grid>
                      </Border>
                    </Grid>

                    <Border IsVisible="{Binding SwapError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="6" Padding="12,9">
                      <TextBlock Text="{Binding SwapError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <Button Classes="primary" Content="{Binding [swap.getQuote], Source={x:Static app:Loc.Instance}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            IsEnabled="{Binding !SwapBusy}" Command="{Binding GetSwapQuoteCommand}"/>
                  </StackPanel>
                </Border>

                <!-- Step 2 · review & confirm -->
                <Border Classes="card" BorderBrush="#7A6230" IsVisible="{Binding HasSwapQuote}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [swap.step2], Source={x:Static app:Loc.Instance}}"/>

                    <!-- You get — the headline figure, matching Send's prominent amount. -->
                    <StackPanel Spacing="2">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}" Text="{Binding [swap.youGet], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Classes="mono" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource UmPos}" Text="{Binding SwapExpectedOut}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="6">
                      <TextBlock Grid.Row="0" Grid.Column="0" Classes="eyebrow" Text="{Binding [swap.rate], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" FontSize="12" Foreground="{DynamicResource UmTextDim}" Text="{Binding SwapRateText}"/>
                      <TextBlock Grid.Row="1" Grid.Column="0" Classes="eyebrow" Text="{Binding [swap.fee], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="12" Foreground="{DynamicResource UmTextDim}" Text="{Binding SwapFeeText}"/>
                      <TextBlock Grid.Row="2" Grid.Column="0" Classes="eyebrow" Text="{Binding [swap.eta], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" FontSize="12" Foreground="{DynamicResource UmTextDim}" Text="{Binding SwapEtaText}"/>
                    </Grid>

                    <!-- Delivered-to address boxed and full, so you can verify where THORChain sends the output. -->
                    <StackPanel Spacing="2">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}" Text="{Binding [swap.toYour], Source={x:Static app:Loc.Instance}}"/>
                      <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1"
                              CornerRadius="8" Padding="10,8">
                        <SelectableTextBlock Classes="mono" FontSize="12" TextWrapping="Wrap"
                                             Foreground="{DynamicResource UmTextSoft}" Text="{Binding SwapDestination}"/>
                      </Border>
                    </StackPanel>

                    <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" Text="{Binding SwapExpiryText}"/>
                    <Border IsVisible="{Binding SwapWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#2A2418" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="6" Padding="12,9">
                      <TextBlock Text="{Binding SwapWarning}" Foreground="#E7CA83" TextWrapping="Wrap" FontSize="11.5"/>
                    </Border>
                    <TextBlock Foreground="#BBAF91" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [swap.confirmNote], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="danger" Content="{Binding [swap.confirmBtn], Source={x:Static app:Loc.Instance}}" IsEnabled="{Binding !IsBusy}" Command="{Binding ConfirmSwapCommand}"/>
                      <Button Classes="ghost" Content="{Binding [common.cancel], Source={x:Static app:Loc.Instance}}" Command="{Binding CancelSwapCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Broadcasting -->
                <Border Classes="card" IsVisible="{Binding IsBusy}">
                  <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/sending.json"
                                   Width="64" Height="64" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource UmTextDim}" FontSize="12.5"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Result -->
                <Border Background="#14231A" BorderBrush="#2F5A3C" BorderThickness="1" CornerRadius="10" Padding="14"
                        IsVisible="{Binding SwapSuccess, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/money.json"
                                   Width="56" Height="56" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Top"/>
                    <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource UmPos}" TextWrapping="Wrap"
                               Text="{Binding SwapSuccess}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Connect watch-only -->
              <StackPanel Classes="page" IsVisible="{Binding IsConnect}" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center" Text="{Binding [connect.title], Source={x:Static app:Loc.Instance}}"/>
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-09.json" Width="42" Height="42" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap" MaxWidth="640"
                           Text="{Binding [connect.watchDesc], Source={x:Static app:Loc.Instance}}"/>
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="eyebrow" Text="{Binding [connect.network], Source={x:Static app:Loc.Instance}}"/>
                        <ComboBox ItemsSource="{Binding WatchableNetworks}"
                                  SelectedItem="{Binding SelectedWatchNetwork}"
                                  HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SendOption">
                              <StackPanel Spacing="1" Margin="0,3">
                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Network}" FontSize="10.5" Foreground="{DynamicResource UmTextDim}"/>
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Classes="eyebrow" Text="{Binding [connect.labelOptional], Source={x:Static app:Loc.Instance}}"/>
                        <TextBox Text="{Binding WatchLabel}" Watermark="{Binding [connect.watchLabelPh], Source={x:Static app:Loc.Instance}}"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Classes="eyebrow" Text="{Binding [connect.publicAddress], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding WatchAddress}" Watermark="{Binding [connect.watchAddrPh], Source={x:Static app:Loc.Instance}}"/>
                    <Button Classes="primary" Content="{Binding [connect.linkBtn], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                            Command="{Binding AddWatchAddressCommand}"/>
                  </StackPanel>
                </Border>
                <!-- Exchange accounts (read-only API keys) -->
                <Border Classes="card" BorderBrush="{DynamicResource UmAccent}">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="{Binding [connect.exchangeAccounts], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [connect.exchangeDesc], Source={x:Static app:Loc.Instance}}"/>

                    <Border Background="#2A2418" BorderBrush="#7A6230" BorderThickness="1"
                            CornerRadius="10" Padding="12">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [connect.readOnlyKey], Source={x:Static app:Loc.Instance}}"/>
                        <TextBlock Foreground="#BBAF91" FontSize="11.5" TextWrapping="Wrap"
                                   Text="{Binding [connect.readOnlyNote], Source={x:Static app:Loc.Instance}}"/>
                      </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="180,*" ColumnSpacing="10">
                      <ComboBox ItemsSource="{Binding SupportedExchanges}"
                                SelectedItem="{Binding ExchangeName, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"/>
                      <TextBox Grid.Column="1" Text="{Binding ExchangeLabel}" Watermark="{Binding [connect.labelPh], Source={x:Static app:Loc.Instance}}"/>
                    </Grid>
                    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap"
                               Text="{Binding ExchangeKeyHint}"/>
                    <TextBox Text="{Binding ExchangeApiKey}" Watermark="{Binding [connect.apiKeyPh], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding ExchangeApiSecret}" PasswordChar="●" Watermark="{Binding [connect.apiSecretPh], Source={x:Static app:Loc.Instance}}"
                             IsVisible="{Binding ExchangeNeedsSecret}"/>
                    <TextBox Text="{Binding ExchangePassphrase}" PasswordChar="●" Watermark="{Binding [connect.apiPassPh], Source={x:Static app:Loc.Instance}}"
                             IsVisible="{Binding ExchangeNeedsPassphrase}"/>

                    <Border IsVisible="{Binding ExchangeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="12,9">
                      <TextBlock Text="{Binding ExchangeError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <TextBlock IsVisible="{Binding ExchangeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding ExchangeStatus}" Foreground="{DynamicResource UmPos}" FontSize="12" TextWrapping="Wrap"/>

                    <Button Classes="primary" Content="{Binding [connect.connectBtn], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                            IsEnabled="{Binding !IsBusy}" Command="{Binding ConnectExchangeCommand}"/>

                    <ItemsControl ItemsSource="{Binding Exchanges}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="infra:ExchangeCredential">
                          <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1"
                                  CornerRadius="10" Padding="12" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Exchange}" FontSize="11" Foreground="{DynamicResource UmTextDim}"/>
                              </StackPanel>
                              <Button Grid.Column="1" Classes="ghost" Content="{Binding [common.disconnect], Source={x:Static app:Loc.Instance}}"
                                      Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).RemoveExchangeCommand}"
                                      CommandParameter="{Binding}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding WatchAddresses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="net:WatchAddress">
                      <Border Classes="card" Margin="0,0,0,8" Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}"/>
                            <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource UmTextDim}"
                                       Text="{Binding Address}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource UmTextMuted}"
                                       Text="{Binding Chain}"/>
                          </StackPanel>
                          <Button Grid.Column="1" Classes="ghost" Content="{Binding [common.remove], Source={x:Static app:Loc.Instance}}"
                                  Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).RemoveWatchAddressCommand}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- NFTs — real: ERC-721/1155 collections at the Ethereum address (names + counts, no images). -->
              <StackPanel Classes="page" IsVisible="{Binding IsNfts}" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                  <Border Width="4" Height="24" CornerRadius="2" Background="{DynamicResource UmAccentBright}"/>
                  <TextBlock Classes="serif" FontSize="26" Text="{Binding [nav.nfts], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/67.json" Width="46" Height="46" VerticalAlignment="Center" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5" MaxWidth="560" TextWrapping="Wrap"
                           Text="{Binding [nft.desc], Source={x:Static app:Loc.Instance}}"/>

                <Border Classes="card" Background="{DynamicResource UmCardAlt}" Padding="16,12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [sec.nftOrigin], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="12.5"/>
                    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="640"
                               Text="{Binding [sec.nftDesc], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Nfts}" IsVisible="{Binding HasNfts}" x:CompileBindings="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card" Margin="0,0,0,10" Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                          <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="{DynamicResource UmAccentWash}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Symbol}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource UmAccentBright}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="36"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource UmTextDim}">
                              <Run Text="{Binding Standard}"/><Run Text=" · "/><Run Text="{Binding Network}"/>
                            </TextBlock>
                          </StackPanel>
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"
                                     Foreground="{DynamicResource UmAccentBright}">
                            <Run Text="×"/><Run Text="{Binding Count}"/>
                          </TextBlock>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="hairline" Padding="40" MinHeight="220" IsVisible="{Binding !HasNfts}">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <Path Classes="tileIcon" Width="46" Height="46" Data="M4 16 L9 11 L13 15 L20 8 M4 5 H20 V19 H4 Z"/>
                    <TextBlock Classes="serif" FontSize="20" Text="{Binding [nft.emptyTitle], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5" MaxWidth="420" TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding [nft.emptyBody], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Staking — stakeable coins the wallet holds keys for, with typical (approximate) rewards. -->
              <StackPanel Classes="page" IsVisible="{Binding IsStaking}" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                  <Border Width="4" Height="24" CornerRadius="2" Background="{DynamicResource UmAccentBright}"/>
                  <TextBlock Classes="serif" FontSize="26" Text="{Binding [nav.staking], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5" MaxWidth="600" TextWrapping="Wrap"
                           Text="{Binding [sec.stakingDesc], Source={x:Static app:Loc.Instance}}"/>

                <ItemsControl ItemsSource="{Binding StakingRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StakingRowViewModel">
                      <Border Classes="card" Margin="0,0,0,10" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                          <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{Binding BadgeBg}" VerticalAlignment="Top" ClipToBounds="True">
                            <Panel>
                              <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" Text="{Binding BadgeGlyph}" FontSize="19" FontWeight="Bold"
                                         Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasBadgeLogo}"/>
                              <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" MinWidth="0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Method}" FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HoldLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource UmAccentBright}"
                                       IsVisible="{Binding HasHolding}" TextWrapping="Wrap"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Apr}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource UmPos}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding [stake.perYear], Source={x:Static app:Loc.Instance}}" FontSize="10" Foreground="{DynamicResource UmTextMuted}" HorizontalAlignment="Right"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap" MaxWidth="600"
                           Text="{Binding [staking.desc], Source={x:Static app:Loc.Instance}}"/>
              </StackPanel>

              <!-- Discover: Market + external Buy / P2P·DEX + News, grouped out of the primary nav (§6.1). -->
              <StackPanel Classes="page" IsVisible="{Binding IsDiscover}" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Classes="serif" FontSize="26"
                           Text="{Binding [nav.discover], Source={x:Static app:Loc.Instance}}"/>
                <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="{Binding [discover.sub], Source={x:Static app:Loc.Instance}}"/>

                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,15"
                        Command="{Binding SelectSectionCommand}" CommandParameter="Market" AutomationProperties.Name="Market">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center"
                            Background="{DynamicResource UmAccentWash}" BorderBrush="{DynamicResource UmBorder3}" BorderThickness="1">
                      <Path Stroke="{DynamicResource UmAccentBright}" StrokeThickness="1.8" StrokeLineCap="Round"
                            StrokeJoin="Round" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Data="M4 19 H20 M4 19 V5 M7 15 L11 10 L14 13 L19 6"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2">
                      <TextBlock Text="{Binding [nav.market], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="15"/>
                      <TextBlock Text="{Binding [discover.market], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextDim}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" FontSize="22" VerticalAlignment="Center" Foreground="{DynamicResource UmTextMuted}"/>
                  </Grid>
                </Button>

                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,15"
                        Command="{Binding SelectSectionCommand}" CommandParameter="Buy" AutomationProperties.Name="Buy">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center"
                            Background="{DynamicResource UmAccentWash}" BorderBrush="{DynamicResource UmBorder3}" BorderThickness="1">
                      <Path Stroke="{DynamicResource UmAccentBright}" StrokeThickness="1.8" StrokeLineCap="Round"
                            StrokeJoin="Round" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12 5 V19 M5 12 H19"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2">
                      <TextBlock Text="{Binding [nav.buy], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="15"/>
                      <TextBlock Text="{Binding [discover.buy], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextDim}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="↗" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource UmTextMuted}"/>
                  </Grid>
                </Button>

                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,15"
                        Command="{Binding SelectSectionCommand}" CommandParameter="P2p" AutomationProperties.Name="P2p">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center"
                            Background="{DynamicResource UmAccentWash}" BorderBrush="{DynamicResource UmBorder3}" BorderThickness="1">
                      <Path Stroke="{DynamicResource UmAccentBright}" StrokeThickness="1.8" StrokeLineCap="Round"
                            StrokeJoin="Round" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Data="M8 8 A3 3 0 1 0 8 7.99 M16 16 A3 3 0 1 0 16 15.99 M9 10 L15 14"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2">
                      <TextBlock Text="{Binding [nav.p2p], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="15"/>
                      <TextBlock Text="{Binding [discover.p2p], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextDim}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="↗" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource UmTextMuted}"/>
                  </Grid>
                </Button>

                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18,15"
                        Command="{Binding SelectSectionCommand}" CommandParameter="News" AutomationProperties.Name="News">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center"
                            Background="{DynamicResource UmAccentWash}" BorderBrush="{DynamicResource UmBorder3}" BorderThickness="1">
                      <Path Stroke="{DynamicResource UmAccentBright}" StrokeThickness="1.8" StrokeLineCap="Round"
                            StrokeJoin="Round" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Data="M5 5 H19 V19 H5 Z M8 9 H16 M8 12 H16 M8 15 H13"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2">
                      <TextBlock Text="{Binding [nav.news], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="15"/>
                      <TextBlock Text="{Binding [discover.news], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextDim}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" FontSize="22" VerticalAlignment="Center" Foreground="{DynamicResource UmTextMuted}"/>
                  </Grid>
                </Button>
              </StackPanel>

              <!-- Market -->
              <StackPanel Classes="page" IsVisible="{Binding IsMarket}" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="serif" FontSize="26"
                               Text="{Binding [market.title], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" Text="{Binding MarketStatus}"/>
                  </StackPanel>

                  <!-- Chart window. Real candles: 1H is 60 one-minute points, not a daily smear. -->
                  <Border Grid.Column="1" Classes="hairline" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button Classes="chip" Content="1H" Command="{Binding SelectChartRangeCommand}"
                              CommandParameter="1H" Classes.active="{Binding IsRange1H}"/>
                      <Button Classes="chip" Content="24H" Command="{Binding SelectChartRangeCommand}"
                              CommandParameter="24H" Classes.active="{Binding IsRange24H}"/>
                      <Button Classes="chip" Content="7D" Command="{Binding SelectChartRangeCommand}"
                              CommandParameter="7D" Classes.active="{Binding IsRange7D}"/>
                      <Button Classes="chip" Content="30D" Command="{Binding SelectChartRangeCommand}"
                              CommandParameter="30D" Classes.active="{Binding IsRange30D}"/>
                      <Button Classes="chip" Content="1Y" Command="{Binding SelectChartRangeCommand}"
                              CommandParameter="1Y" Classes.active="{Binding IsRange1Y}"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Detail chart (click a coin) -->
                <Border Classes="card" IsVisible="{Binding HasChart}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                      <TextBlock Text="{Binding SelectedMarketName}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedMarketSymbol}" Classes="mono" FontSize="11"
                                 Foreground="{DynamicResource UmTextMuted}" Margin="8,4,0,0" VerticalAlignment="Center"/>
                      <!-- Up/down market stickers, chosen by the chart window's direction. -->
                      <lottie:Lottie Grid.Column="2" Path="avares://Umbrella.Wallet.App/Assets/stickers/up.json"
                                     Width="38" Height="38" HorizontalAlignment="Left" Margin="10,0,0,0"
                                     IsVisible="{Binding ChartIsUp}"
                                     RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                      <lottie:Lottie Grid.Column="2" Path="avares://Umbrella.Wallet.App/Assets/stickers/down.json"
                                     Width="38" Height="38" HorizontalAlignment="Left" Margin="10,0,0,0"
                                     IsVisible="{Binding !ChartIsUp}"
                                     RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                      <TextBlock Grid.Column="3" Text="{Binding SelectedMarketPriceLabel}" Classes="mono" FontSize="15"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <Button Grid.Column="4" Classes="chip" Content="{Binding [common.close], Source={x:Static app:Loc.Instance}}" Command="{Binding CloseChartCommand}"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <TextBlock Text="{Binding ChartRange, StringFormat='{}{0} PRICE · USD'}" Classes="eyebrow" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Background="{Binding ChartChangeColor, Converter={StaticResource ChangeWash}}"
                              CornerRadius="999" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ChartChangeLabel}" Foreground="{Binding ChartChangeColor}"
                                   Classes="mono" FontSize="11.5" FontWeight="SemiBold"/>
                      </Border>
                      <!-- Line ⇄ Candles toggle, like a pro charting view. -->
                      <Border Grid.Column="3" Classes="hairline" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Classes="chip" Content="{Binding [chart.line], Source={x:Static app:Loc.Instance}}" Command="{Binding SetChartViewCommand}"
                                  CommandParameter="Line" Classes.active="{Binding IsLineView}"/>
                          <Button Classes="chip" Content="{Binding [chart.candles], Source={x:Static app:Loc.Instance}}" Command="{Binding SetChartViewCommand}"
                                  CommandParameter="Candles" Classes.active="{Binding IsCandleView}"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border Background="{DynamicResource UmBg}" CornerRadius="10" Height="196" Padding="0" ClipToBounds="True">
                      <Panel>
                        <TextBlock Text="{Binding [chart.loading], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextMuted}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsChartLoading}"/>
                        <!-- Grid positions are constants (always five levels, five ticks), so the
                             lines and labels are placed directly rather than through an
                             ItemsControl, which does not position generated Canvas children.
                             The Viewbox scales the fixed 870×152 plot to fit whatever width the
                             window gives it — so nothing is clipped on a narrow window and it grows
                             gracefully on a wide/maximised one. Background=Transparent so PointerMoved
                             fires across the whole plot (crosshair); GetPosition returns the Canvas's
                             own 0–870 space regardless of the Viewbox scale, so the crosshair stays true. -->
                        <Viewbox Stretch="Uniform" StretchDirection="Both" MaxHeight="178"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0">
                        <Canvas x:Name="ChartCanvas" Background="Transparent" Width="870" Height="152"
                                PointerMoved="OnChartPointerMoved" PointerExited="OnChartPointerExited">
                          <Line StartPoint="58,10"  EndPoint="860,10"  Stroke="{DynamicResource UmBorder}" StrokeThickness="1"/>
                          <Line StartPoint="58,40"  EndPoint="860,40"  Stroke="{DynamicResource UmBorder}" StrokeThickness="1"/>
                          <Line StartPoint="58,70"  EndPoint="860,70"  Stroke="{DynamicResource UmBorder}" StrokeThickness="1"/>
                          <Line StartPoint="58,100" EndPoint="860,100" Stroke="{DynamicResource UmBorder}" StrokeThickness="1"/>
                          <Line StartPoint="58,130" EndPoint="860,130" Stroke="{DynamicResource UmBorder2}" StrokeThickness="1"/>

                          <TextBlock Canvas.Left="2" Canvas.Top="3"   Classes="mono" FontSize="9.5" Width="52" TextAlignment="Right" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartLevel0}"/>
                          <TextBlock Canvas.Left="2" Canvas.Top="33"  Classes="mono" FontSize="9.5" Width="52" TextAlignment="Right" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartLevel1}"/>
                          <TextBlock Canvas.Left="2" Canvas.Top="63"  Classes="mono" FontSize="9.5" Width="52" TextAlignment="Right" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartLevel2}"/>
                          <TextBlock Canvas.Left="2" Canvas.Top="93"  Classes="mono" FontSize="9.5" Width="52" TextAlignment="Right" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartLevel3}"/>
                          <TextBlock Canvas.Left="2" Canvas.Top="123" Classes="mono" FontSize="9.5" Width="52" TextAlignment="Right" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartLevel4}"/>

                          <!-- Soft gradient area (change-colour → transparent) + the price line. -->
                          <!-- Area fill belongs to Line mode only; in Candle mode it smothered the candles
                               into a solid blob, so it's hidden there and the real candlesticks show. -->
                          <Polygon Points="{Binding ChartArea}" Fill="{Binding ChartAreaBrush}" IsVisible="{Binding IsLineView}"/>
                          <!-- Faint backdrop line while candles are shown. -->
                          <Polyline Points="{Binding ChartPoints}" Stroke="{Binding SelectedMarketChangeColor}"
                                    StrokeThickness="1" Opacity="0.28" StrokeLineCap="Round" StrokeJoin="Round"
                                    IsVisible="{Binding IsCandleView}"/>
                          <!-- Bold line in Line mode (Uniswap-style: clean line over a soft area). -->
                          <Polyline Points="{Binding ChartPoints}" Stroke="{Binding SelectedMarketChangeColor}"
                                    StrokeThickness="2.8" StrokeLineCap="Round" StrokeJoin="Round"
                                    IsVisible="{Binding IsLineView}"/>

                          <!-- Volume bars along the bottom, behind the candles (pro-terminal cue). -->
                          <ItemsControl ItemsSource="{Binding ChartVolumeBars}" x:CompileBindings="False">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                              <Style Selector="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                              </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:VolumeBarVm">
                                <Rectangle Width="{Binding W}" Height="{Binding H}" Fill="{Binding Color}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- Real OHLC candlesticks (Binance klines): green up, red down. Reflection
                               bindings on the container (its DataContext is the CandleVm, not the VM). -->
                          <ItemsControl ItemsSource="{Binding ChartCandles}" x:CompileBindings="False"
                                        IsVisible="{Binding IsCandleView}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                              <Style Selector="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding ItemX}"/>
                                <Setter Property="Canvas.Top" Value="{Binding ItemY}"/>
                              </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CandleVm">
                                <Canvas Width="{Binding W}" Height="{Binding H}">
                                  <Rectangle Canvas.Left="{Binding WickLocalX}" Width="1.4" Height="{Binding H}" Fill="{Binding Color}"/>
                                  <Rectangle Canvas.Top="{Binding BodyLocalY}" Width="{Binding W}" Height="{Binding BodyH}" Fill="{Binding Color}"/>
                                </Canvas>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- Moving-average overlay (gold) on top of the candles — the pro-chart trend line. -->
                          <Polyline Points="{Binding ChartMa}" Stroke="#E7B24C" StrokeThickness="1.6"
                                    Opacity="0.9" StrokeLineCap="Round" StrokeJoin="Round"
                                    IsVisible="{Binding IsCandleView}"/>

                          <!-- Crosshair (hover): vertical guide, dot on the close, floating readout. -->
                          <Rectangle Canvas.Left="{Binding CrosshairLineLeft}" Canvas.Top="10" Width="1" Height="120"
                                     Fill="{DynamicResource UmTextMuted}" Opacity="0.55" IsVisible="{Binding CrosshairVisible}"/>
                          <Ellipse Canvas.Left="{Binding CrosshairDotLeft}" Canvas.Top="{Binding CrosshairDotTop}"
                                   Width="8" Height="8" Fill="{Binding SelectedMarketChangeColor}"
                                   Stroke="{DynamicResource UmBg}" StrokeThickness="1.5" IsVisible="{Binding CrosshairVisible}"/>
                          <Border Canvas.Left="{Binding CrosshairLabelLeft}" Canvas.Top="12" Width="124"
                                  Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder}"
                                  BorderThickness="1" CornerRadius="6" Padding="8,4" IsVisible="{Binding CrosshairVisible}">
                            <StackPanel Spacing="1">
                              <TextBlock Classes="mono" FontSize="12" FontWeight="SemiBold" Text="{Binding CrosshairPrice}"/>
                              <TextBlock Classes="mono" FontSize="9.5" Foreground="{DynamicResource UmTextMuted}" Text="{Binding CrosshairTime}"/>
                            </StackPanel>
                          </Border>

                          <TextBlock Canvas.Left="40"  Canvas.Top="135" Classes="mono" FontSize="9.5" Width="36" TextAlignment="Center" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartTime0}"/>
                          <TextBlock Canvas.Left="240" Canvas.Top="135" Classes="mono" FontSize="9.5" Width="36" TextAlignment="Center" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartTime1}"/>
                          <TextBlock Canvas.Left="441" Canvas.Top="135" Classes="mono" FontSize="9.5" Width="36" TextAlignment="Center" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartTime2}"/>
                          <TextBlock Canvas.Left="641" Canvas.Top="135" Classes="mono" FontSize="9.5" Width="36" TextAlignment="Center" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartTime3}"/>
                          <TextBlock Canvas.Left="842" Canvas.Top="135" Classes="mono" FontSize="9.5" Width="36" TextAlignment="Center" Foreground="{DynamicResource UmTextMuted}" Text="{Binding ChartTime4}"/>
                        </Canvas>
                        </Viewbox>

                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,8,12,0">
                          <TextBlock Classes="mono" FontSize="10" Foreground="{DynamicResource UmTextDim}"
                                     Text="{Binding ChartHigh}"/>
                          <TextBlock Classes="mono" FontSize="10" Foreground="{DynamicResource UmTextDim}"
                                     Text="{Binding ChartLow}"/>
                        </StackPanel>
                      </Panel>
                    </Border>

                    <!-- Uniswap-style stats row (24h), from the same Binance feed. -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding HasMarketStats}" Margin="0,4,0,0">
                      <Border Classes="hairline" Padding="14,12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="eyebrow" Text="{Binding [market.high24h], Source={x:Static app:Loc.Instance}}"/>
                          <TextBlock Classes="mono" FontSize="15" Text="{Binding StatHigh24h}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="hairline" Padding="14,12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="eyebrow" Text="{Binding [market.low24h], Source={x:Static app:Loc.Instance}}"/>
                          <TextBlock Classes="mono" FontSize="15" Text="{Binding StatLow24h}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Classes="hairline" Padding="14,12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="eyebrow" Text="{Binding [market.vol24h], Source={x:Static app:Loc.Instance}}"/>
                          <TextBlock Classes="mono" FontSize="15" Text="{Binding StatVolume24h}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- Richer stats from the optional CoinGecko connector. -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasRichStats}" Margin="0,2,0,0">
                      <Border Classes="hairline" Padding="14,12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="eyebrow" Text="{Binding [market.mcap], Source={x:Static app:Loc.Instance}}"/>
                          <TextBlock Classes="mono" FontSize="15" Text="{Binding StatMarketCap}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="hairline" Padding="14,12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="eyebrow" Text="{Binding [market.fdv], Source={x:Static app:Loc.Instance}}"/>
                          <TextBlock Classes="mono" FontSize="15" Text="{Binding StatFdv}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Overview: movers and the watchlist, both computed from prices the wallet has
                     ALREADY fetched. No extra endpoint and no extra request — a privacy wallet should
                     not pay for an overview screen with more traffic. Coins with no live price are left
                     out rather than shown as a flat 0%. -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding HasMarketMovers}">
                  <Border Classes="card" Padding="16,14">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding [market.gainers], Source={x:Static app:Loc.Instance}}"/>
                      <ItemsControl ItemsSource="{Binding MarketGainers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MarketRowViewModel">
                            <Button Classes="ghost" Padding="8,5" Margin="0,1" MinHeight="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).SelectMarketCoinCommand}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding ChangeLabel}"
                                           Foreground="{Binding ChangeColor}" VerticalAlignment="Center"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card" Padding="16,14">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding [market.losers], Source={x:Static app:Loc.Instance}}"/>
                      <ItemsControl ItemsSource="{Binding MarketLosers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MarketRowViewModel">
                            <Button Classes="ghost" Padding="8,5" Margin="0,1" MinHeight="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).SelectMarketCoinCommand}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding ChangeLabel}"
                                           Foreground="{Binding ChangeColor}" VerticalAlignment="Center"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Classes="card" Padding="16,14">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding [market.watchlist], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UmTextDim}"
                                 IsVisible="{Binding !HasWatchlist}"
                                 Text="{Binding [market.watchEmpty], Source={x:Static app:Loc.Instance}}"/>
                      <ItemsControl ItemsSource="{Binding MarketWatchlist}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MarketRowViewModel">
                            <Button Classes="ghost" Padding="8,5" Margin="0,1" MinHeight="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).SelectMarketCoinCommand}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Margin="0,0,8,0"
                                           Text="{Binding PriceLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Classes="mono" FontSize="11.5" Text="{Binding ChangeLabel}"
                                           Foreground="{Binding ChangeColor}" VerticalAlignment="Center"/>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Search: filters rows by ticker or name without touching the live-update list. -->
                <Grid ColumnDefinitions="*,Auto">
                  <Border Classes="hairline" Padding="12,0" Height="40">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                      <Path Classes="tileIcon" Width="16" Height="16" Stretch="Uniform"
                            Data="M11 11 L15 15 M13 8 A5 5 0 1 1 3 8 A5 5 0 0 1 13 8"/>
                      <TextBox Grid.Column="1" Text="{Binding MarketQuery, Mode=TwoWay}" Watermark="{Binding [market.searchPh], Source={x:Static app:Loc.Instance}}"
                               BorderThickness="0" Background="Transparent" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" Classes="chip" Content="{Binding [common.clear], Source={x:Static app:Loc.Instance}}" Command="{Binding ClearMarketQueryCommand}"
                              IsVisible="{Binding MarketQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Grid>
                  </Border>
                  <Button Grid.Column="1" Classes="chip" Content="{Binding [common.refresh], Source={x:Static app:Loc.Instance}}" Margin="10,0,0,0" VerticalAlignment="Center"
                          Command="{Binding RefreshMarketCommand}"/>
                </Grid>

                <Border Classes="hairline">
                  <StackPanel>
                    <Grid ColumnDefinitions="1.6*,Auto,1.1*,0.8*,1.4*" Height="34" Background="{DynamicResource UmCard}">
                      <TextBlock Classes="eyebrow" Text="{Binding [col.coin], Source={x:Static app:Loc.Instance}}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding ChartRange}" Width="110" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Classes="eyebrow" Text="{Binding [col.price], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Classes="eyebrow" Text="{Binding [col.24h], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="4" Classes="eyebrow" Text="{Binding [col.thisWallet], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Market}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MarketRowViewModel">
                          <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"
                                  AutomationProperties.Name="{Binding Name}"
                                  Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).SelectMarketCoinCommand}"
                                  CommandParameter="{Binding}">
                            <Button.IsVisible>
                              <MultiBinding Converter="{StaticResource MarketFilter}">
                                <Binding Path="Symbol"/>
                                <Binding Path="Name"/>
                                <Binding Path="#RootWindow.((vm:MainViewModel)DataContext).MarketQuery"/>
                              </MultiBinding>
                            </Button.IsVisible>
                            <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Height="58">
                              <Grid ColumnDefinitions="1.6*,Auto,1.1*,0.8*,1.4*" Margin="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                  <!-- Watchlist star. Nested in the row button on purpose: starring a coin
                                       must not also open its chart, so it carries its own command. -->
                                  <Button Classes="ghost" Padding="6,2" MinHeight="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding [market.watchHint], Source={x:Static app:Loc.Instance}}"
                                          ToolTip.Tip="{Binding [market.watchHint], Source={x:Static app:Loc.Instance}}"
                                          Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).ToggleWatchCommand}"
                                          CommandParameter="{Binding Symbol}">
                                    <TextBlock Text="{Binding WatchGlyph}" Foreground="{Binding WatchColor}" FontSize="14"/>
                                  </Button>
                                  <Border Width="32" Height="32" CornerRadius="16" Background="{Binding BadgeBg}" ClipToBounds="True">
                                    <Panel>
                                      <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" FontSize="16" FontWeight="Bold"
                                                 Foreground="#FFFFFF" Text="{Binding BadgeGlyph}" IsVisible="{Binding !HasBadgeLogo}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                                    </Panel>
                                  </Border>
                                  <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource UmTextMuted}" Text="{Binding NetworkLabel}"
                                               TextTrimming="CharacterEllipsis"/>
                                  </StackPanel>
                                </StackPanel>
                                <!-- Inline sparkline at the selected window: every coin gets a chart, not just the selected one. -->
                                <Canvas Grid.Column="1" Width="110" Height="30" VerticalAlignment="Center" Margin="10,0">
                                  <Polyline Points="{Binding Spark}" Stroke="{Binding ChangeColor}"
                                            StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                            IsVisible="{Binding HasSpark}"/>
                                </Canvas>
                                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding PriceLabel}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Classes="mono" Text="{Binding ChangeLabel}"
                                           Foreground="{Binding ChangeColor}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" FontSize="11.5" Text="{Binding Accepts}"
                                           Foreground="{Binding AcceptsColor}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                              </Grid>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="720"
                           Text="{Binding [market.footer], Source={x:Static app:Loc.Instance}}"/>
              </StackPanel>

              <!-- Buy (fiat on-ramps) -->
              <StackPanel Classes="page" IsVisible="{Binding IsBuy}" Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="serif" FontSize="26" Text="{Binding [section.buyCrypto], Source={x:Static app:Loc.Instance}}"/>
                  <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12"
                             Text="{Binding [sec.buyDesc], Source={x:Static app:Loc.Instance}}"/>
                </StackPanel>

                <!-- How it works: three steps, then a shortcut to the address you'll paste. -->
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [sec.howItWorks], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [buy.step1], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="{Binding [buy.step1body], Source={x:Static app:Loc.Instance}}" FontSize="11.5"
                                   Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding [buy.step2], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="{Binding [buy.step2body], Source={x:Static app:Loc.Instance}}" FontSize="11.5"
                                   Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{Binding [buy.step3], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="{Binding [buy.step3body], Source={x:Static app:Loc.Instance}}" FontSize="11.5"
                                   Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="primary" Content="{Binding [buy.showAddresses], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding SelectSectionCommand}" CommandParameter="Receive"/>
                      <Button Classes="ghost" Content="{Binding [buy.copyPrimary], Source={x:Static app:Loc.Instance}}" Command="{Binding CopyPrimaryAddressCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Classes="eyebrow" Text="{Binding [buy.providers], Source={x:Static app:Loc.Instance}}" Margin="2,4,0,0"/>

                <Border Classes="hairline">
                  <ItemsControl ItemsSource="{Binding OnRampVenues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:P2pVenue">
                        <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="16,14">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{Binding Accent}" VerticalAlignment="Top">
                              <TextBlock Classes="mono" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" Text="{Binding Tag}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Kind, Converter={StaticResource ActivityLabel}}" FontSize="11" Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmAccentDim}" BorderThickness="1"
                                        CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Custody}" FontSize="9.5" Foreground="{DynamicResource UmTextSoft}"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource UmTextDim}"
                                         TextWrapping="Wrap" MaxWidth="620"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="ghost" Content="{Binding [common.open], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).OpenUrlCommand}"
                                    CommandParameter="{Binding Url}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>

                <Border Classes="card" Background="{DynamicResource UmCardAlt}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [sec.beforeBuy], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="720"
                               Text="{Binding [buy.disclaimer], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- P2P & DEX -->
              <StackPanel Classes="page" IsVisible="{Binding IsP2p}" Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="serif" FontSize="26" Text="{Binding [p2p.title], Source={x:Static app:Loc.Instance}}"/>
                  <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12"
                             Text="{Binding [p2p.desc], Source={x:Static app:Loc.Instance}}"/>
                </StackPanel>

                <!-- Hero: the in-wallet swap comes first (nothing leaves the app). -->
                <Border Classes="card">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{DynamicResource UmAccent}" CornerRadius="6" Padding="6,2">
                          <TextBlock Text="{Binding [p2p.inWallet], Source={x:Static app:Loc.Instance}}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock Text="{Binding [sec.swapHere], Source={x:Static app:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="560"
                                 Text="{Binding [p2p.swapCard], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="primary" Content="{Binding [p2p.openSwap], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Swap"/>
                  </Grid>
                </Border>

                <TextBlock Classes="eyebrow" Text="{Binding [p2p.external], Source={x:Static app:Loc.Instance}}" Margin="2,4,0,0"/>

                <Border Classes="hairline">
                  <ItemsControl ItemsSource="{Binding P2pVenues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:P2pVenue">
                        <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="16,14">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{Binding Accent}" VerticalAlignment="Top">
                              <TextBlock Classes="mono" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Text="{Binding Tag}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Kind, Converter={StaticResource ActivityLabel}}" FontSize="11" Foreground="{DynamicResource UmTextMuted}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource UmCardAlt}" BorderBrush="{DynamicResource UmPos}" BorderThickness="1"
                                        CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Custody}" FontSize="9.5" Foreground="{DynamicResource UmPos}"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource UmTextDim}"
                                         TextWrapping="Wrap" MaxWidth="620"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="ghost" Content="{Binding [common.open], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).OpenUrlCommand}"
                                    CommandParameter="{Binding Url}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>

                <Border Classes="card" Background="{DynamicResource UmCardAlt}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding [sec.safety], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="720"
                               Text="{Binding [p2p.disclaimer], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- News -->
              <StackPanel Classes="page" IsVisible="{Binding IsNews}" Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center"
                             Text="{Binding [nav.news], Source={x:Static app:Loc.Instance}}"/>
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-12.json" Width="42" Height="42" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5"
                           Text="{Binding [news.desc], Source={x:Static app:Loc.Instance}}"/>

                <!-- Official Telegram channel — the one place for news and contact. -->
                <Border Classes="card" Background="{DynamicResource UmCardAlt}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Width="42" Height="42" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Center">
                      <Image Source="avares://Umbrella.Wallet.App/Assets/tg-news.jpg" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding [sec.tgChannel], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                      <TextBlock Text="{Binding [about.channel], Source={x:Static app:Loc.Instance}}"
                                 FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="primary" Content="{Binding [common.open], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"
                            Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ChannelUrl}"/>
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding News}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NewsItemViewModel">
                      <!-- One clean card per item: a single bordered card that IS the button, so there
                           is no doubled edge (a ghost button wrapped around a card looked broken). -->
                      <Button Classes="row" CornerRadius="14" Margin="0,0,0,10" Padding="0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).OpenNewsCommand}" CommandParameter="{Binding}">
                        <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder}"
                                BorderThickness="1" CornerRadius="14" Padding="18,15">
                          <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                              <Border Background="{Binding TagColor}" CornerRadius="6" Padding="8,2">
                                <TextBlock Text="{Binding Tag}" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="#0C0D10" LetterSpacing="1"/>
                              </Border>
                              <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{DynamicResource UmTextMuted}"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Body}" FontSize="12.5" Foreground="{DynamicResource UmTextDim}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding [news.read], Source={x:Static app:Loc.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource UmAccent}"/>
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Transactions — money movements only (sends, receives, swaps), with explorer links. -->
              <!-- Activity (merged with Transactions per roadmap §6) -->
              <StackPanel Classes="page" IsVisible="{Binding IsActivity}" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center" Text="{Binding [nav.activity], Source={x:Static app:Loc.Instance}}"/>
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-10.json" Width="42" Height="42" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5" Margin="2,0,0,4"
                           Text="{Binding [activity.desc], Source={x:Static app:Loc.Instance}}"/>

                <!-- Last sync + on-demand refresh: the history is fetched from public explorers, so tell
                     the user how fresh it is and let them re-pull it. -->
                <Border Classes="card" Padding="12,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Classes="eyebrow" Text="{Binding [activity.lastSync], Source={x:Static app:Loc.Instance}}"
                                 VerticalAlignment="Center"/>
                      <TextBlock Classes="mono" FontSize="12" Foreground="{DynamicResource UmTextDim}"
                                 Text="{Binding LastHistorySync}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Classes="ghost" Padding="12,5" MinHeight="0"
                              Content="{Binding [activity.export], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding ExportHistoryCsvCommand}"/>
                      <Button Classes="ghost" Padding="12,5" MinHeight="0"
                              Content="{Binding [activity.refresh], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding RefreshHistoryCommand}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Filters (§6): category, asset, status and date each narrow the one merged feed. -->
                <WrapPanel Orientation="Horizontal" Margin="2,0,0,2">
                  <StackPanel Spacing="3" Margin="0,0,14,8">
                    <TextBlock Classes="eyebrow" Text="{Binding [activity.filterType], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding ActivityFilters}" SelectedItem="{Binding ActivityFilter, Mode=TwoWay}" MinWidth="150">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding Converter={StaticResource ActivityLabel}}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="3" Margin="0,0,14,8">
                    <TextBlock Classes="eyebrow" Text="{Binding [activity.filterAsset], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding ActivityAssets}" SelectedItem="{Binding ActivityAssetFilter, Mode=TwoWay}" MinWidth="110">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding Converter={StaticResource ActivityLabel}}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="3" Margin="0,0,14,8">
                    <TextBlock Classes="eyebrow" Text="{Binding [activity.filterStatus], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding ActivityStatuses}" SelectedItem="{Binding ActivityStatusFilter, Mode=TwoWay}" MinWidth="130">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding Converter={StaticResource ActivityLabel}}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="3" Margin="0,0,0,8">
                    <TextBlock Classes="eyebrow" Text="{Binding [activity.filterDate], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding ActivityDateRanges}" SelectedItem="{Binding ActivityDateFilter, Mode=TwoWay}" MinWidth="140">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding Converter={StaticResource ActivityLabel}}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </WrapPanel>

                <!-- Empty state — distinguishes "still fetching" from "synced, genuinely nothing", so an
                     empty feed never reads as broken. -->
                <Border Classes="card" IsVisible="{Binding !HasFilteredActivity}" MinHeight="120">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <!-- Fetching on-chain history -->
                    <StackPanel IsVisible="{Binding HistoryLoading}" Spacing="8" HorizontalAlignment="Center">
                      <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-10.json" Width="46" Height="46"
                                     HorizontalAlignment="Center" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}"/>
                      <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource UmTextDim}"
                                 Text="{Binding [activity.loading], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                    <!-- Synced, but nothing on-chain / matching -->
                    <StackPanel IsVisible="{Binding !HistoryLoading}" Spacing="6" HorizontalAlignment="Center">
                      <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource UmTextDim}"
                                 Text="{Binding [activity.empty], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"
                                 FontSize="12" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding [activity.emptyHint], Source={x:Static app:Loc.Instance}}"/>
                      <Button Classes="ghost" Padding="12,5" MinHeight="0" Margin="0,4,0,0" HorizontalAlignment="Center"
                              Content="{Binding [activity.refresh], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding RefreshHistoryCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Private note editor (encrypted at rest). Opens when 📝 is tapped on a transaction. -->
                <Border IsVisible="{Binding IsEditingNote}" Background="{DynamicResource UmCard}"
                        BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1" CornerRadius="10"
                        Padding="12" Margin="0,0,0,10">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                               Text="{Binding [notes.title], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding NoteDraft}" AcceptsReturn="True" MaxLength="280" MinHeight="54"
                             TextWrapping="Wrap"
                             Watermark="{Binding [notes.placeholder], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{Binding [notes.save], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding SaveNoteCommand}"/>
                      <Button Classes="ghost" Content="{Binding [common.cancel], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding CancelEditNoteCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding FilteredActivity}" IsVisible="{Binding HasFilteredActivity}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityRowViewModel">
                      <!-- Each event is its own rounded card. The card itself copies the explorer link
                           (a no-op when there is none); the Retry / note buttons live inside it and stay
                           independently clickable. -->
                      <Button Classes="ghost" Padding="0" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyActivityLinkCommand}"
                              CommandParameter="{Binding}">
                        <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder}"
                                BorderThickness="1" CornerRadius="12" MinHeight="54" Padding="16,8">
                          <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="96,58,*,Auto,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Kind, Converter={StaticResource ActivityLabel}}" Foreground="{Binding KindColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="12" Text="{Binding Asset, Converter={StaticResource ActivityLabel}}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Classes="mono" FontSize="12" Foreground="{DynamicResource UmTextDim}"
                                       Text="{Binding Counterparty, Converter={StaticResource ActivityLabel}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Amount, Converter={StaticResource ActivityLabel}}" Foreground="{Binding KindColor}"
                                       Margin="12,0" VerticalAlignment="Center"/>
                            <!-- Confirmation-status pill (money movements only) + Retry on a failed send. -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0" VerticalAlignment="Center">
                              <Border IsVisible="{Binding ShowStatus}" Background="Transparent" BorderBrush="{Binding StatusColor}"
                                      BorderThickness="1" CornerRadius="7" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding StatusColor}"
                                           Text="{Binding StatusLabel}"/>
                              </Border>
                              <Button Classes="ghost" Padding="10,3" MinHeight="0" VerticalAlignment="Center"
                                      IsVisible="{Binding CanRetry}"
                                      Content="{Binding [activity.retry], Source={x:Static app:Loc.Instance}}"
                                      Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).RetrySendCommand}"
                                      CommandParameter="{Binding}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <!-- Add / edit a private (encrypted) note on this transaction. -->
                              <Button Classes="ghost" Padding="6,2" MinHeight="0" VerticalAlignment="Center"
                                      IsVisible="{Binding CanHaveNote}" Content="📝"
                                      ToolTip.Tip="{Binding [notes.add], Source={x:Static app:Loc.Instance}}"
                                      Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).BeginEditNoteCommand}"
                                      CommandParameter="{Binding}"/>
                              <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="11" Text="{Binding When, Converter={StaticResource ActivityLabel}}" VerticalAlignment="Center"/>
                              <TextBlock Foreground="{DynamicResource UmAccent}" FontSize="11" Text="↗" IsVisible="{Binding HasLink}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Grid>
                          <!-- The saved private note, shown under the row when present. -->
                          <TextBlock IsVisible="{Binding HasNote}" Text="{Binding Note}" Margin="96,0,0,0"
                                     FontSize="11.5" Foreground="{DynamicResource UmTextSoft}" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- ===== ASSET DETAILS =====
                   One coin end to end: the holding, the live price, the address it lives on, what this
                   build can actually do with it (read from ChainCatalog, so the page cannot promise a
                   capability the wallet lacks) and the movements that touched it. -->
              <StackPanel Classes="page" IsVisible="{Binding IsAsset}" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                <Button Classes="ghost" Padding="12,5" MinHeight="0" HorizontalAlignment="Left"
                        Content="{Binding [asset.back], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding SelectSectionCommand}" CommandParameter="Portfolio"/>

                <!-- Identity + price header -->
                <Border Classes="card" Padding="20,16">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="46" Height="46" CornerRadius="23" Background="{Binding AssetBadgeBg}"
                            ClipToBounds="True" VerticalAlignment="Center">
                      <Panel>
                        <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="Bold"
                                   Foreground="#FFFFFF" Text="{Binding AssetBadgeGlyph}" IsVisible="{Binding !AssetHasBadgeLogo}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding AssetBadgeLogo}" IsVisible="{Binding AssetHasBadgeLogo}" Stretch="Uniform"/>
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding AssetName}" FontSize="20" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding AssetNetwork}" FontSize="11.5" Foreground="{DynamicResource UmTextDim}"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Classes="mono" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"
                                 Text="{Binding AssetPriceLabel}"/>
                      <TextBlock Classes="mono" FontSize="12" HorizontalAlignment="Right"
                                 Text="{Binding AssetChangeLabel}" Foreground="{Binding AssetChangeColor}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Holding. Follows the same hide-balances rule as the rest of the wallet. -->
                <Border Classes="card" Padding="20,16">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding [asset.holding], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Classes="mono" FontSize="24" FontWeight="SemiBold"
                                 Text="{Binding AssetValueLabel}" IsVisible="{Binding AreValuesVisible}"/>
                      <TextBlock Classes="mono" FontSize="24" FontWeight="SemiBold" Text="•••••"
                                 IsVisible="{Binding IsBalanceHidden}"/>
                      <TextBlock Classes="mono" FontSize="12.5" Foreground="{DynamicResource UmTextDim}"
                                 Text="{Binding AssetAmountLabel}" IsVisible="{Binding AreValuesVisible}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="Transparent" BorderBrush="{Binding AssetStatusColor}" BorderThickness="1"
                            CornerRadius="7" Padding="9,2" VerticalAlignment="Top">
                      <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding AssetStatusColor}"
                                 Text="{Binding AssetStatusLabel}"/>
                    </Border>
                  </Grid>
                </Border>

                <!-- Actions. Each is offered only where this build can really do it. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Padding="14,7" MinHeight="0" IsVisible="{Binding AssetHasAddress}"
                          Content="{Binding [asset.capReceive], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding AssetReceiveCommand}"/>
                  <Button Classes="ghost" Padding="14,7" MinHeight="0" IsVisible="{Binding AssetCanSend}"
                          Content="{Binding [asset.capSend], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding AssetSendCommand}"/>
                  <Button Classes="ghost" Padding="14,7" MinHeight="0" IsVisible="{Binding AssetCanSwap}"
                          Content="{Binding [asset.capSwap], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding SelectSectionCommand}" CommandParameter="Swap"/>
                  <Button Classes="ghost" Padding="14,7" MinHeight="0"
                          Content="{Binding [asset.chart], Source={x:Static app:Loc.Instance}}"
                          Command="{Binding AssetChartCommand}"/>
                </StackPanel>

                <!-- Address on this device -->
                <Border Classes="card" Padding="16,14">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                               Text="{Binding [asset.address], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding AssetHasAddress}"
                               Foreground="{DynamicResource UmTextSoft}" Text="{Binding AssetAddress}"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding !AssetHasAddress}"
                               Foreground="{DynamicResource UmTextDim}"
                               Text="{Binding [asset.noAddress], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AssetHasAddress}">
                      <Button Classes="ghost" Padding="12,4" MinHeight="0"
                              Content="{Binding [common.copyAddress], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding CopyAddressCommand}" CommandParameter="{Binding AssetAddress}"/>
                    </StackPanel>
                    <TextBlock Classes="mono" FontSize="10.5" Foreground="{DynamicResource UmTextMuted}"
                               IsVisible="{Binding AssetDerivation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding AssetDerivation}"/>
                  </StackPanel>
                </Border>

                <!-- Honest capability + privacy lines, straight from the chain catalog. -->
                <Border Classes="card" Padding="16,14">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                               Text="{Binding [asset.capabilities], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding AssetCapabilityLine}"/>
                    <TextBlock Classes="eyebrow" Margin="0,8,0,0" Foreground="{DynamicResource UmTextMuted}"
                               IsVisible="{Binding AssetPrivacyNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding [asset.privacy], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource UmTextDim}"
                               IsVisible="{Binding AssetPrivacyNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding AssetPrivacyNote}"/>
                  </StackPanel>
                </Border>

                <!-- This asset's movements -->
                <TextBlock Classes="eyebrow" Margin="2,4,0,0" Foreground="{DynamicResource UmTextMuted}"
                           Text="{Binding [asset.activity], Source={x:Static app:Loc.Instance}}"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource UmTextDim}" Margin="2,0,0,0"
                           IsVisible="{Binding !HasAssetActivity}"
                           Text="{Binding [asset.noActivity], Source={x:Static app:Loc.Instance}}"/>
                <ItemsControl ItemsSource="{Binding AssetActivity}" IsVisible="{Binding HasAssetActivity}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityRowViewModel">
                      <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder}"
                              BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="96,*,Auto,Auto">
                          <TextBlock Text="{Binding Kind, Converter={StaticResource ActivityLabel}}" Foreground="{Binding KindColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Classes="mono" FontSize="12" Foreground="{DynamicResource UmTextDim}"
                                     Text="{Binding Counterparty, Converter={StaticResource ActivityLabel}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Amount, Converter={StaticResource ActivityLabel}}" Foreground="{Binding KindColor}"
                                     Margin="12,0" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Foreground="{DynamicResource UmTextDim}" FontSize="11"
                                     Text="{Binding When, Converter={StaticResource ActivityLabel}}" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- ===== SECURITY CENTER =====
                   One screen answering "what is actually protecting this wallet right now?". Every row
                   is computed from live settings, so a protection that is off says so instead of being
                   quietly left out, and the score only counts things the user can switch on. -->
              <StackPanel Classes="page" IsVisible="{Binding IsSecurity}" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center"
                             Text="{Binding [sec.title], Source={x:Static app:Loc.Instance}}"/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12.5" Margin="2,0,0,4" TextWrapping="Wrap"
                           Text="{Binding [sec.subtitle], Source={x:Static app:Loc.Instance}}"/>

                <!-- Privacy Radar: the wallet's network/metadata anonymity at a glance, privacy-WEIGHTED
                     (Tor is the biggest lever), with the single biggest win named. Distinct from the raw
                     protection count below it. -->
                <Border Classes="card" Padding="18,14" BorderBrush="#5A6B8C">
                  <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                      <TextBlock FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                                 Foreground="{Binding PrivacyGradeColor}" Text="{Binding PrivacyScoreValue}"/>
                      <TextBlock FontSize="10" Foreground="{DynamicResource UmTextMuted}" HorizontalAlignment="Center"
                                 Text="/ 100"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="{Binding [pscore.title], Source={x:Static app:Loc.Instance}}"/>
                        <Border Background="{DynamicResource UmAccentWash}" CornerRadius="5" Padding="7,1" VerticalAlignment="Center">
                          <TextBlock FontSize="11" FontWeight="SemiBold"
                                     Foreground="{Binding PrivacyGradeColor}" Text="{Binding PrivacyGradeLabel}"/>
                        </Border>
                      </StackPanel>
                      <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"
                                 Text="{Binding [pscore.subtitle], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Text="{Binding PrivacyTopFix}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Score header: how many switchable protections are on, right now. -->
                <Border Classes="card" Padding="18,14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{Binding SecurityScoreColor}"
                                 Text="{Binding SecurityScoreLabel}"/>
                      <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" TextWrapping="Wrap"
                                 Text="{Binding ConnectionLabel}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Padding="14,6" MinHeight="0" VerticalAlignment="Center"
                            Content="{Binding [sec.refresh], Source={x:Static app:Loc.Instance}}"
                            Command="{Binding RefreshSecurityCommand}"/>
                  </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding SecurityChecks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SecurityCheckVm">
                      <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder}"
                              BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="30,*,Auto">
                          <TextBlock Text="{Binding Glyph}" FontSize="15" VerticalAlignment="Top" Margin="0,1,0,0"/>
                          <StackPanel Grid.Column="1" Spacing="3" Margin="6,0,12,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource UmTextDim}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                            <Border Background="Transparent" BorderBrush="{Binding StateColor}" BorderThickness="1"
                                    CornerRadius="7" Padding="9,2" HorizontalAlignment="Right">
                              <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding StateColor}"
                                         Text="{Binding StateLabel}"/>
                            </Border>
                            <!-- The remedy sits on the row that needs it: no hunting through Settings. -->
                            <Button Classes="ghost" Padding="10,4" MinHeight="0" HorizontalAlignment="Right"
                                    IsVisible="{Binding ActionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Content="{Binding ActionLabel}"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).OpenSecurityActionCommand}"
                                    CommandParameter="{Binding ActionTarget}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Settings. Split into panes: one long scroll buried the danger zone under the
                   status bar, and no amount of padding makes a 2000px column discoverable. -->
              <StackPanel Classes="page" IsVisible="{Binding IsSettings}" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="serif" FontSize="26" VerticalAlignment="Center" Text="{Binding [settings.title], Source={x:Static app:Loc.Instance}}"/>
                  <lottie:Lottie Path="avares://Umbrella.Wallet.App/Assets/stickers/fear-11.json" Width="42" Height="42" RepeatCount="{Binding #RootWindow.((vm:MainViewModel)DataContext).LottieRepeat}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search across every setting; results jump straight to the right pane. -->
                <StackPanel Spacing="0">
                  <Border Classes="hairline" Padding="12,0" Height="40">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                      <Path Classes="tileIcon" Width="16" Height="16" Stretch="Uniform"
                            Data="M11 11 L15 15 M13 8 A5 5 0 1 1 3 8 A5 5 0 0 1 13 8"/>
                      <TextBox Grid.Column="1" Text="{Binding SettingsSearch, Mode=TwoWay}" Watermark="{Binding [settings.searchPh], Source={x:Static app:Loc.Instance}}"
                               BorderThickness="0" Background="Transparent" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      <Button Grid.Column="2" Classes="chip" Content="✕" Command="{Binding OpenSettingCommand}"
                              AutomationProperties.Name="{Binding [common.clear], Source={x:Static app:Loc.Instance}}"
                              CommandParameter="" IsVisible="{Binding SettingsSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Grid>
                  </Border>
                  <Border Classes="card" Margin="0,6,0,0" Padding="6"
                          IsVisible="{Binding SettingsSearch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding SettingsResults}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SettingsShortcut">
                            <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8"
                                    Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).OpenSettingCommand}"
                                    CommandParameter="{Binding Tab}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{DynamicResource UmCardAlt}" CornerRadius="5" Padding="7,2">
                                  <TextBlock Text="{Binding TabLabel}" FontSize="10.5" Foreground="{DynamicResource UmTextMuted}"/>
                                </Border>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding [settings.noMatch], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextMuted}" FontSize="12"
                                 Margin="10,8" IsVisible="{Binding !HasSettingsResults}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <Border Classes="hairline" Padding="4" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Appearance first: theme and language are what people look for. -->
                    <Button Classes="chip" Content="{Binding [settings.appearance], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Appearance"
                            Classes.active="{Binding IsTabAppearance}"/>
                    <Button Classes="chip" Content="{Binding [settings.tabWallets], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Wallets"
                            Classes.active="{Binding IsTabWallets}"/>
                    <Button Classes="chip" Content="{Binding [settings.security], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Security"
                            Classes.active="{Binding IsTabSecurity}"/>
                    <Button Classes="chip" Content="{Binding [settings.privacy], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Privacy"
                            Classes.active="{Binding IsTabPrivacy}"/>
                    <Button Classes="chip" Content="{Binding [settings.backup], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Backup"
                            Classes.active="{Binding IsTabBackup}"/>
                    <Button Classes="chip" Content="{Binding [settings.guide], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Guide"
                            Classes.active="{Binding IsTabGuide}"/>
                    <Button Classes="chip" Content="{Binding [settings.danger], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSettingsTabCommand}" CommandParameter="Danger"
                            Classes.active="{Binding IsTabDanger}"/>
                  </StackPanel>
                </Border>

                <!-- Wallets: Binance-style multiple independent wallets. Each is its own encrypted seed. -->
                <Border Classes="card" IsVisible="{Binding IsTabWallets}" BorderBrush="{DynamicResource UmAccent}">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.walletsTitle], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap" MaxWidth="640"
                               Text="{Binding [settings.walletsHint], Source={x:Static app:Loc.Instance}}"/>

                    <!-- The wallet list. -->
                    <ItemsControl ItemsSource="{Binding Wallets}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WalletListItemViewModel">
                          <Border Background="{DynamicResource UmCardAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                              <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource UmAccentWash}" VerticalAlignment="Center"
                                      BorderThickness="2" BorderBrush="{Binding ColorBrush}">
                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource UmAccentBright}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource UmTextMuted}"/>
                              </StackPanel>
                              <Button Grid.Column="2" Classes="chip" Content="{Binding [settings.walletSwitch], Source={x:Static app:Loc.Instance}}"
                                      IsVisible="{Binding !IsActive}" VerticalAlignment="Center"
                                      Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).SwitchWalletCommand}"
                                      CommandParameter="{Binding Id}"/>
                              <Button Grid.Column="3" Classes="ghost" Content="{Binding [settings.walletRemove], Source={x:Static app:Loc.Instance}}"
                                      IsVisible="{Binding CanRemove}" VerticalAlignment="Center"
                                      Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).RemoveWalletCommand}"
                                      CommandParameter="{Binding Id}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Rename the active wallet. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBox Text="{Binding RenameWalletLabel, Mode=TwoWay}" Watermark="{Binding [settings.walletRenameWatermark], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Classes="ghost" Content="{Binding [settings.walletRename], Source={x:Static app:Loc.Instance}}" Command="{Binding RenameActiveWalletCommand}"/>
                    </Grid>

                    <!-- Colour-tag the active wallet. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding [settings.walletColor], Source={x:Static app:Loc.Instance}}"
                                 VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource UmTextDim}"/>
                      <Button Width="24" Height="24" Padding="0" Background="#E08A8A" Command="{Binding SetWalletColorCommand}" CommandParameter="#E08A8A"/>
                      <Button Width="24" Height="24" Padding="0" Background="#E7CA83" Command="{Binding SetWalletColorCommand}" CommandParameter="#E7CA83"/>
                      <Button Width="24" Height="24" Padding="0" Background="#8FCB9B" Command="{Binding SetWalletColorCommand}" CommandParameter="#8FCB9B"/>
                      <Button Width="24" Height="24" Padding="0" Background="#6EA8FE" Command="{Binding SetWalletColorCommand}" CommandParameter="#6EA8FE"/>
                      <Button Width="24" Height="24" Padding="0" Background="#B99CF0" Command="{Binding SetWalletColorCommand}" CommandParameter="#B99CF0"/>
                      <Button Width="24" Height="24" Padding="0" Background="#5AC8B4" Command="{Binding SetWalletColorCommand}" CommandParameter="#5AC8B4"/>
                      <Button Classes="chip" Content="✕" Command="{Binding SetWalletColorCommand}" CommandParameter="clear"
                              AutomationProperties.Name="{Binding [common.clear], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>

                    <!-- Single-coin / selected-coin wallets: pick which coins this wallet shows. -->
                    <TextBlock Text="{Binding [settings.walletCoins], Source={x:Static app:Loc.Instance}}"
                               FontSize="12" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding WalletCoinToggles}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CoinToggle">
                          <Button Classes="chip" Margin="0,0,6,6"
                                  Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).ToggleWalletCoinCommand}"
                                  CommandParameter="{Binding Symbol}" Classes.active="{Binding Enabled}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Border Width="16" Height="16" CornerRadius="8" Background="{Binding BadgeBg}" ClipToBounds="True">
                                <Panel>
                                  <TextBlock FontFamily="Segoe UI Symbol, Segoe UI Variable, Segoe UI" Text="{Binding BadgeGlyph}"
                                             FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" IsVisible="{Binding !HasBadgeLogo}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  <Image Source="{Binding BadgeLogo}" IsVisible="{Binding HasBadgeLogo}" Stretch="Uniform"/>
                                </Panel>
                              </Border>
                              <TextBlock Text="{Binding Symbol}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [settings.walletAddTitle], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="640"
                                   Text="{Binding [settings.walletAddHint], Source={x:Static app:Loc.Instance}}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBox Text="{Binding NewWalletLabel, Mode=TwoWay}" Watermark="{Binding [settings.walletAddWatermark], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Classes="primary" Content="{Binding [settings.walletAdd], Source={x:Static app:Loc.Instance}}" Command="{Binding BeginAddWalletCommand}"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Change the app password (re-encrypts every wallet on the common password). -->
                    <Border BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding [settings.changePwTitle], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="640"
                                   Text="{Binding [settings.changePwHint], Source={x:Static app:Loc.Instance}}"/>
                        <TextBox Text="{Binding ChangePwCurrent, Mode=TwoWay}" PasswordChar="●" Watermark="{Binding [settings.changePwCurrent], Source={x:Static app:Loc.Instance}}"/>
                        <TextBox Text="{Binding ChangePwNew, Mode=TwoWay}" PasswordChar="●" Watermark="{Binding [settings.changePwNew], Source={x:Static app:Loc.Instance}}"/>
                        <TextBox Text="{Binding ChangePwConfirm, Mode=TwoWay}" PasswordChar="●" Watermark="{Binding [settings.changePwConfirm], Source={x:Static app:Loc.Instance}}"/>
                        <Button Classes="ghost" Content="{Binding [settings.changePwBtn], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                                IsEnabled="{Binding !IsBusy}" Command="{Binding ChangePasswordCommand}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- Appearance: language + theme -->
                <Border Classes="card" IsVisible="{Binding IsTabAppearance}" BorderBrush="{DynamicResource UmAccent}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding [settings.language], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.languageHint], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedValue="{Binding LanguageCode, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Code}"
                              Width="260" HorizontalAlignment="Left">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="app:Loc+Language">
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Border>

                <!-- Display currency -->
                <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.currency], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.currencyHint], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding Currencies}"
                              SelectedValue="{Binding CurrencyCode, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Code}"
                              Width="260" HorizontalAlignment="Left">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="app:Fx+Currency">
                          <TextBlock>
                            <Run Text="{Binding Symbol}"/><Run Text="  "/><Run Text="{Binding Code}"/><Run Text=" · "/><Run Text="{Binding Name}"/>
                          </TextBlock>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding [settings.theme], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.themeHint], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                              SelectedValue="{Binding ThemeId, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Id}"
                              Width="260" HorizontalAlignment="Left">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="app:Theming+ThemeOption">
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding [settings.qrNote], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.nav], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.navHint], Source={x:Static app:Loc.Instance}}"/>
                    <!-- SelectedValue, not SelectedItem: a TwoWay SelectedItem pushed the first entry back
                         during initialisation and overwrote the saved choice. -->
                    <ComboBox ItemsSource="{Binding SidebarPositions}"
                              SelectedValue="{Binding SidebarPosition, Mode=TwoWay}"
                              Width="260" HorizontalAlignment="Left"/>

                  </StackPanel>
                </Border>

                <!-- Motion: turn the looping stickers / subtle animation on or off. -->
                <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.motion], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.motionHint], Source={x:Static app:Loc.Instance}}"/>
                    <ToggleSwitch IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}"
                                  OnContent="{Binding [settings.animOn], Source={x:Static app:Loc.Instance}}"
                                  OffContent="{Binding [settings.animOff], Source={x:Static app:Loc.Instance}}"/>
                    <!-- Individual toggles (only meaningful while the master toggle is on). -->
                    <StackPanel IsVisible="{Binding AnimationsEnabled}" Spacing="6" Margin="0,4,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding [settings.rain], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding RainEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding [settings.portfolioVideo], Source={x:Static app:Loc.Instance}}" FontSize="13"/>
                          <TextBlock Text="{Binding [settings.portfolioVideoHint], Source={x:Static app:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding PortfolioVideo, Mode=TwoWay}" OnContent="" OffContent=""/>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding [settings.stickers], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StickersEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding [settings.aurora], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AuroraEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.profile], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.profileHint], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding WalletName, Mode=TwoWay}" Watermark="{Binding [settings.walletNameHint], Source={x:Static app:Loc.Instance}}"
                             MaxWidth="360" HorizontalAlignment="Left"/>
                    <!-- Sidebar background is the only profile image actually shown in the UI; the old
                         avatar/banner pickers were removed because nothing displayed them. -->
                    <WrapPanel>
                      <Button Classes="ghost" Content="{Binding [settings.sidebarBg], Source={x:Static app:Loc.Instance}}" Margin="0,0,8,8" Command="{Binding PickSidebarBgCommand}"/>
                      <Button Classes="ghost" Content="{Binding [settings.reset], Source={x:Static app:Loc.Instance}}" Margin="0,0,8,8" Command="{Binding ClearProfileImagesCommand}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Lock-screen background: pick your own, revert to default, or hide it entirely. -->
                <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.lockScreen], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.lockScreenHint], Source={x:Static app:Loc.Instance}}"/>
                    <WrapPanel>
                      <Button Classes="ghost" Content="{Binding [settings.lockBgChoose], Source={x:Static app:Loc.Instance}}" Margin="0,0,8,8" Command="{Binding PickLockBgCommand}"/>
                      <Button Classes="ghost" Content="{Binding [settings.lockBgReset], Source={x:Static app:Loc.Instance}}" Margin="0,0,8,8" Command="{Binding ClearLockBgCommand}"/>
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding [settings.lockPlain], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" FontSize="13"/>
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding LockScreenPlain, Mode=TwoWay}" OnContent="" OffContent=""/>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Updates: manual, Tor-aware. Data is never touched by an update. -->
                <Border Classes="card" IsVisible="{Binding IsTabAppearance}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.updates], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.updatesHint], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Content="{Binding [settings.checkUpdates], Source={x:Static app:Loc.Instance}}" Command="{Binding CheckForUpdatesCommand}"/>
                      <Button Classes="ghost" Content="{Binding [settings.copyDownload], Source={x:Static app:Loc.Instance}}" Command="{Binding CopyReleasesLinkCommand}"
                              IsVisible="{Binding UpdateAvailable}"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource UmAccent}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding UpdateStatus}" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.encryption], Source={x:Static app:Loc.Instance}}"/>
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                      <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" Text="{Binding [settings.vault], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                                 Text="{Binding VaultCryptoLabel}"/>
                      <TextBlock Grid.Row="1" Foreground="{DynamicResource UmTextDim}" FontSize="12" Text="{Binding [settings.seed], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                                 Text="{Binding SeedSchemeLabel}"/>
                      <TextBlock Grid.Row="2" Foreground="{DynamicResource UmTextDim}" FontSize="12" Text="{Binding [settings.vaultFile], Source={x:Static app:Loc.Instance}}"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" FontSize="11.5" TextWrapping="Wrap"
                                 Foreground="{DynamicResource UmTextDim}" Text="{Binding VaultLocation}"/>
                    </Grid>
                    <Button Classes="ghost" Content="{Binding [settings.openVaultFolder], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                            Command="{Binding OpenVaultFolderCommand}"/>
                  </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.autolock], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.autolockHint], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding AutoLockOptions}" SelectedValue="{Binding AutoLockChoice, Mode=TwoWay}"
                              MinWidth="220" HorizontalAlignment="Left"/>
                    <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource UmTextMuted}" Text="{Binding AutoLockLabel}"/>

                    <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

                    <TextBlock Classes="eyebrow" Text="{Binding [settings.hideBal], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.hideBalHint], Source={x:Static app:Loc.Instance}}"/>
                    <ToggleSwitch IsChecked="{Binding HideBalancesDefault, Mode=TwoWay}"
                                  OnContent="{Binding [settings.hideBalOn], Source={x:Static app:Loc.Instance}}"
                                  OffContent="{Binding [settings.hideBalOff], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                </Border>

                <!-- Local cybersecurity posture — everything that protects the wallet on this machine. -->
                <!-- Live Security Center shortcut — replaces the old static bullet list, which the
                     Security Center now shows dynamically with real on/off state. -->
                <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center"
                            Background="{DynamicResource UmAccentWash}" BorderBrush="{DynamicResource UmBorder3}" BorderThickness="1">
                      <Path Stroke="{DynamicResource UmAccentBright}" StrokeThickness="1.8" StrokeLineCap="Round"
                            StrokeJoin="Round" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M12 3 L20 6 V12 C20 16.4 16.6 19.7 12 21 C7.4 19.7 4 16.4 4 12 V6 Z"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding [settings.secCenter], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                      <TextBlock Text="{Binding [settings.secCenterHint], Source={x:Static app:Loc.Instance}}"
                                 FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center"
                            Content="{Binding [settings.openSecCenter], Source={x:Static app:Loc.Instance}}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Security"/>
                  </Grid>
                </Border>

                <!-- Prove address ownership: sign a message with the Ethereum key (never moves funds —
                     EIP-191 personal_sign), or verify anyone's signed message. -->
                <Border Classes="card" IsVisible="{Binding IsTabSecurity}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [signmsg.title], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [signmsg.hint], Source={x:Static app:Loc.Instance}}"/>

                    <TextBlock Classes="eyebrow" Margin="0,4,0,0" Text="{Binding [signmsg.yourAddress], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Classes="mono" FontSize="11.5" Foreground="{DynamicResource UmTextSoft}" TextWrapping="Wrap"
                               Text="{Binding SignMsgAddress}"/>
                    <TextBox Text="{Binding SignMsgInput}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"
                             Watermark="{Binding [signmsg.messagePh], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="ghost" Content="{Binding [signmsg.signBtn], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding SignMessageCommand}"/>
                      <Button Classes="ghost" IsVisible="{Binding SignMsgSignature, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Content="{Binding [signmsg.copySig], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding CopySignatureCommand}"/>
                    </StackPanel>
                    <Border IsVisible="{Binding SignMsgSignature, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource UmBg}" BorderBrush="{DynamicResource UmBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                      <TextBlock Classes="mono" FontSize="11" TextWrapping="Wrap" Text="{Binding SignMsgSignature}"/>
                    </Border>

                    <Border Height="1" Background="{DynamicResource UmBorder}" Margin="0,6,0,6"/>

                    <TextBlock Classes="eyebrow" Text="{Binding [signmsg.verifyTitle], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding VerifyMsgAddress}" Watermark="{Binding [signmsg.addrPh], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding VerifyMsgText}" AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap"
                             Watermark="{Binding [signmsg.messagePh], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding VerifyMsgSignature}" Watermark="{Binding [signmsg.sigPh], Source={x:Static app:Loc.Instance}}"/>
                    <Button Classes="ghost" HorizontalAlignment="Left"
                            Content="{Binding [signmsg.verifyBtn], Source={x:Static app:Loc.Instance}}"
                            Command="{Binding VerifyMessageCommand}"/>
                    <TextBlock IsVisible="{Binding VerifyMsgResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding VerifyMsgResult}" Foreground="{Binding VerifyMsgColor}" FontWeight="SemiBold" FontSize="12.5"/>
                  </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.privacyNet], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource UmPos}" VerticalAlignment="Center"/>
                      <TextBlock FontSize="12" Foreground="{DynamicResource UmTextSoft}"
                                 Text="{Binding [settings.priv1], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource UmPos}" VerticalAlignment="Center"/>
                      <TextBlock FontSize="12" Foreground="{DynamicResource UmTextSoft}"
                                 Text="{Binding [settings.priv2], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="7" Height="7" Fill="#E7CA83" VerticalAlignment="Center"/>
                      <TextBlock FontSize="12" Foreground="{DynamicResource UmTextSoft}" TextWrapping="Wrap" MaxWidth="600"
                                 Text="{Binding [settings.priv3], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.endpoints], Source={x:Static app:Loc.Instance}}" Margin="0,4,0,0"/>
                    <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"
                               Text="{Binding NetworkLabel}"/>
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.chains], Source={x:Static app:Loc.Instance}}" Margin="0,4,0,0"/>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource UmPos}"
                               Text="{Binding SupportedChainsLabel, StringFormat='Address + balance: {0}'}"/>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextDim}"
                               Text="{Binding PlannedChainsLabel, StringFormat='Adapter pending: {0}'}"/>
                  </StackPanel>
                </Border>

                <!-- Tor -->
                <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.tor], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.torHint], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <ToggleSwitch IsChecked="{Binding TorEnabled}"
                                    OnContent="{Binding [settings.torOn], Source={x:Static app:Loc.Instance}}"
                                    OffContent="{Binding [settings.torOff], Source={x:Static app:Loc.Instance}}"
                                    Command="{Binding ApplyTorCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Text="{Binding TorStatus}" Foreground="{Binding TorStatusColor}" TextWrapping="Wrap"/>

                    <!-- Tor-only kill-switch: fail-closed so a dropped/off Tor never leaks to clearnet. -->
                    <StackPanel Spacing="6" Margin="0,6,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                          <TextBlock FontWeight="SemiBold" FontSize="13"
                                     Text="{Binding [priv.torOnly], Source={x:Static app:Loc.Instance}}"/>
                          <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="11.5" TextWrapping="Wrap"
                                     Text="{Binding [priv.torOnlyDesc], Source={x:Static app:Loc.Instance}}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding TorOnly, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Top"/>
                      </Grid>
                      <TextBlock FontSize="11.5" Classes="mono" Foreground="{DynamicResource UmTextMuted}"
                                 Text="{Binding TorOnlyStatus}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Verify Tor: honest proof the anonymity toggle actually routes through Tor. -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                      <Button Classes="ghost" Padding="14,7" MinHeight="0" HorizontalAlignment="Left"
                              IsEnabled="{Binding !TorChecking}"
                              Content="{Binding [priv.torCheck], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding VerifyTorCommand}"/>
                      <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                 IsVisible="{Binding TorCheckStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 Text="{Binding TorCheckStatus}" Foreground="{Binding TorCheckColor}"/>
                    </StackPanel>

                    <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

                    <TextBlock Classes="eyebrow" Text="{Binding [settings.moneroSvc], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.moneroSvcHint], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <ToggleSwitch IsChecked="{Binding MoneroEnabled}"
                                    OnContent="{Binding [settings.moneroOn], Source={x:Static app:Loc.Instance}}"
                                    OffContent="{Binding [settings.moneroOff], Source={x:Static app:Loc.Instance}}"
                                    Command="{Binding EnableMoneroCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Text="{Binding MoneroStatus}" Foreground="{Binding MoneroStatusColor}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Advanced network privacy: custom proxy, IP family, clipboard hygiene -->
                <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.proxy], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.proxyHint], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <ToggleSwitch IsChecked="{Binding CustomProxyEnabled}"
                                    OnContent="{Binding [settings.proxyOn], Source={x:Static app:Loc.Instance}}"
                                    OffContent="{Binding [settings.proxyOff], Source={x:Static app:Loc.Instance}}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding CustomProxyUri}" Watermark="socks5://127.0.0.1:9050"/>
                      <Button Grid.Column="1" Classes="chip"
                              Content="{Binding [settings.proxyApply], Source={x:Static app:Loc.Instance}}"
                              Command="{Binding ApplyCustomProxyCommand}"/>
                    </Grid>
                    <TextBlock FontSize="12" Text="{Binding ProxyStatus}" Foreground="{Binding ProxyStatusColor}" TextWrapping="Wrap"/>

                    <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

                    <TextBlock Classes="eyebrow" Text="{Binding [settings.ipMode], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.ipModeHint], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding IpModeOptions}" SelectedItem="{Binding IpModeChoice}"
                              HorizontalAlignment="Stretch"/>

                    <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

                    <TextBlock Classes="eyebrow" Text="{Binding [settings.clipboard], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.clipboardHint], Source={x:Static app:Loc.Instance}}"/>
                    <ComboBox ItemsSource="{Binding ClipboardClearOptions}" SelectedItem="{Binding ClipboardClearChoice}"
                              HorizontalAlignment="Stretch"/>

                    <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

                    <TextBlock Classes="eyebrow" Text="{Binding [settings.lockMin], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.lockMinHint], Source={x:Static app:Loc.Instance}}"/>
                    <ToggleSwitch IsChecked="{Binding LockOnMinimize, Mode=TwoWay}"
                                  OnContent="{Binding [settings.lockMinOn], Source={x:Static app:Loc.Instance}}"
                                  OffContent="{Binding [settings.lockMinOff], Source={x:Static app:Loc.Instance}}"/>

                    <Border Background="#22FFFFFF" Height="1" Margin="0,10,0,4"/>

                    <TextBlock Classes="eyebrow" Text="{Binding [settings.richData], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.richDataHint], Source={x:Static app:Loc.Instance}}"/>
                    <ToggleSwitch IsChecked="{Binding RichMarketData, Mode=TwoWay}"
                                  OnContent="{Binding [settings.richOn], Source={x:Static app:Loc.Instance}}"
                                  OffContent="{Binding [settings.richOff], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                </Border>

                <!-- Address checker: paste any address to see which network it is for and whether it is
                     well-formed. Local and read-only — a "verify, don't trust" convenience. -->
                <Border Classes="card" IsVisible="{Binding IsTabPrivacy}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [addrchk.title], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [addrchk.hint], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding AddrCheckInput}" TextWrapping="Wrap"
                             Watermark="{Binding [addrchk.placeholder], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock IsVisible="{Binding HasAddrCheck}" Text="{Binding AddrCheckResult}"
                               Foreground="{Binding AddrCheckColor}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Documentation -->
                <Border Classes="card" IsVisible="{Binding IsTabGuide}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="eyebrow" Text="{Binding [settings.documentation], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Classes="ghost" Content="{Binding [settings.openGuide], Source={x:Static app:Loc.Instance}}" Command="{Binding ToggleDocsCommand}"/>
                    </Grid>
                    <!-- Localised guide: driven by the VM's GuideSections, which follow the wallet's
                         language (Ukrainian translated in full; English base/fallback otherwise). -->
                    <ItemsControl ItemsSource="{Binding GuideSections}" IsVisible="{Binding IsDocsVisible}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:GuideSection">
                          <StackPanel Spacing="6" Margin="0,0,0,14">
                            <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextSoft}" Text="{Binding Title}"/>
                            <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap" Text="{Binding Body}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Backup file: a copy of the still-encrypted vault, never the plain seed. -->
                <Border Classes="card" IsVisible="{Binding IsTabBackup}" BorderBrush="{DynamicResource UmAccent}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.backupFile], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.backupHint], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Button Classes="primary" Content="{Binding [settings.saveBackup], Source={x:Static app:Loc.Instance}}" Command="{Binding ExportBackupCommand}"/>
                      <Button Classes="ghost" Content="{Binding [settings.restoreBackup], Source={x:Static app:Loc.Instance}}" Command="{Binding RestoreBackupCommand}"/>
                    </StackPanel>

                    <!-- Verify a backup actually decrypts with its password — without revealing the seed. -->
                    <TextBlock Classes="eyebrow" Margin="0,6,0,0"
                               Text="{Binding [settings.verifyBackup], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding BackupVerifyPassword}" PasswordChar="●"
                             Watermark="{Binding [settings.verifyBackupPw], Source={x:Static app:Loc.Instance}}"/>
                    <Button Classes="ghost" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"
                            Content="{Binding [settings.verifyBackupBtn], Source={x:Static app:Loc.Instance}}"
                            Command="{Binding VerifyBackupCommand}"/>
                    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding [settings.pwVsPhrase], Source={x:Static app:Loc.Instance}}"/>

                    <TextBlock IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding BackupStatus}" Foreground="{DynamicResource UmPos}" FontSize="12" TextWrapping="Wrap"/>
                    <Border IsVisible="{Binding BackupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="12,9">
                      <TextBlock Text="{Binding BackupError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding [settings.restoreNote], Source={x:Static app:Loc.Instance}}"/>
                  </StackPanel>
                </Border>

                <!-- Recovery phrase + (optional) Monero keys in ONE card, so it's clear the 24-word
                     phrase is the real backup and the Monero keys are an advanced extra most people
                     never need. -->
                <Border Classes="card" IsVisible="{Binding IsTabBackup}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Text="{Binding [settings.recovery], Source={x:Static app:Loc.Instance}}"/>
                    <!-- Plain-language explanation of the two things below. -->
                    <Border Background="{DynamicResource UmCardAlt}" CornerRadius="8" Padding="12,10">
                      <TextBlock Foreground="{DynamicResource UmTextSoft}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                 Text="{Binding [settings.keysIntro], Source={x:Static app:Loc.Instance}}"/>
                    </Border>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.recoveryHint], Source={x:Static app:Loc.Instance}}"/>
                    <TextBox Text="{Binding SettingsPassword}" PasswordChar="●" Watermark="{Binding [settings.vaultPassword], Source={x:Static app:Loc.Instance}}" MaxWidth="320" HorizontalAlignment="Left"/>
                    <Button Classes="ghost" Content="{Binding [settings.revealPhrase], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                            IsEnabled="{Binding !IsBusy}" Command="{Binding RevealPhraseCommand}"/>

                    <StackPanel IsVisible="{Binding IsSettingsPhraseVisible}" Spacing="6" Margin="0,4,0,0">
                      <!-- Tap the phrase box to copy it (same as the create screen). -->
                      <Button Command="{Binding CopySettingsPhraseCommand}" Cursor="Hand"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16"
                              Background="{DynamicResource UmBg}" BorderBrush="#7A6230" BorderThickness="1" CornerRadius="10">
                        <Button.Styles>
                          <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource UmBg}"/>
                            <Setter Property="BorderBrush" Value="#9A7E3E"/>
                          </Style>
                        </Button.Styles>
                        <TextBlock Classes="mono" FontSize="14" LineHeight="26" TextWrapping="Wrap"
                                   Text="{Binding SettingsRevealedPhrase}"/>
                      </Button>
                      <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="11" TextWrapping="Wrap"
                                 Text="{Binding [backup.copyHint], Source={x:Static app:Loc.Instance}}"/>
                      <Button Classes="ghost" Content="{Binding [settings.hidePhrase], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                              Command="{Binding HideSettingsPhraseCommand}"/>
                    </StackPanel>

                    <!-- Secondary, clearly-optional: Monero keys, folded into the same card. -->
                    <Border Background="#22FFFFFF" Height="1" Margin="0,12,0,4"/>
                    <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextDim}"
                               Text="{Binding [settings.moneroAdvanced], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.moneroExportHint], Source={x:Static app:Loc.Instance}}"/>
                    <Button Classes="ghost" Content="{Binding [settings.revealMoneroKeys], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                            IsEnabled="{Binding !IsBusy}" Command="{Binding RevealMoneroKeysCommand}"/>

                    <Border IsVisible="{Binding IsMoneroKeysVisible}" Background="{DynamicResource UmBg}"
                            BorderBrush="#7A6230" BorderThickness="1" CornerRadius="10" Padding="16">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [settings.primaryAddress], Source={x:Static app:Loc.Instance}}"/>
                        <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" Text="{Binding MoneroAddress}"/>
                        <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [settings.spendKey], Source={x:Static app:Loc.Instance}}"/>
                        <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" Text="{Binding MoneroSpendKey}"/>
                        <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [settings.viewKey], Source={x:Static app:Loc.Instance}}"/>
                        <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" Text="{Binding MoneroViewKey}"/>
                        <Button Classes="ghost" Content="{Binding [settings.hideKeys], Source={x:Static app:Loc.Instance}}" HorizontalAlignment="Left"
                                Command="{Binding HideMoneroKeysCommand}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- Reversible-ish maintenance (keeps the vault + funds) before the irreversible wipe. -->
                <Border Classes="card" BorderBrush="#7A6230" IsVisible="{Binding IsTabDanger}">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="eyebrow" Foreground="#E7CA83" Text="{Binding [settings.maintenance], Source={x:Static app:Loc.Instance}}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding [settings.clearHistory], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"
                                   Text="{Binding [settings.clearHistoryHint], Source={x:Static app:Loc.Instance}}"/>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Content="{Binding [settings.clear], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" Command="{Binding ClearHistoryCommand}"/>
                    </Grid>
                    <Border Background="#22FFFFFF" Height="1"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding [settings.disconnectAll], Source={x:Static app:Loc.Instance}}" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextDim}" TextWrapping="Wrap"
                                   Text="{Binding [settings.disconnectAllHint], Source={x:Static app:Loc.Instance}}"/>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Content="{Binding [settings.disconnect], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center" Command="{Binding DisconnectAllCommand}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="card" BorderBrush="#7A3034" IsVisible="{Binding IsTabDanger}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow" Foreground="#E09A9A" Text="{Binding [settings.dangerZone], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Foreground="{DynamicResource UmTextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.dangerHint], Source={x:Static app:Loc.Instance}}"/>
                    <Border Background="#2A1618" BorderBrush="#7A3034" BorderThickness="1" CornerRadius="8" Padding="14,11">
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                        <Ellipse Grid.Row="0" Width="7" Height="7" Fill="#E09A9A" VerticalAlignment="Top" Margin="0,5,9,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="#E7C4C4" TextWrapping="Wrap"
                                   Text="{Binding [settings.danger1], Source={x:Static app:Loc.Instance}}"/>
                        <Ellipse Grid.Row="1" Width="7" Height="7" Fill="#E09A9A" VerticalAlignment="Top" Margin="0,5,9,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="#E7C4C4" TextWrapping="Wrap"
                                   Text="{Binding [settings.danger2], Source={x:Static app:Loc.Instance}}"/>
                        <Ellipse Grid.Row="2" Width="7" Height="7" Fill="#E09A9A" VerticalAlignment="Top" Margin="0,5,9,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="#E7C4C4" TextWrapping="Wrap"
                                   Text="{Binding [settings.danger3], Source={x:Static app:Loc.Instance}}"/>
                      </Grid>
                    </Border>
                    <TextBlock Foreground="{DynamicResource UmTextMuted}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding [settings.dangerConfirmHint], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBox Text="{Binding DeleteConfirmation}" Watermark="{Binding DeleteKeyword}" Width="160"/>
                      <Button Classes="danger" Content="{Binding [settings.deleteVault], Source={x:Static app:Loc.Instance}}" Command="{Binding DeleteVaultCommand}"/>
                      <Button Classes="ghost" Content="{Binding [settings.lockNow], Source={x:Static app:Loc.Instance}}" Command="{Binding LockCommand}"/>
                    </StackPanel>
                    <Border IsVisible="{Binding HasFormError}" Background="#2A1618" BorderBrush="#7A3034"
                            BorderThickness="1" CornerRadius="6" Padding="12,9">
                      <TextBlock Text="{Binding FormError}" Foreground="#E09A9A" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Guarantees the last card (Danger Zone) can always be scrolled clear of the
                   status bar, whatever the window height. -->
              <Border Height="48" Background="Transparent"/>

            </StackPanel>
          </ScrollViewer>

          <!-- Right rail (Portfolio only): overview ring · recent activity · market overview.
               Collapses to zero width on other sections (Auto column + a hidden Border). -->
          <Border Grid.Column="1" IsVisible="{Binding ShowSideRail}" Width="330"
                  Background="{DynamicResource UmBgAlt}" BorderBrush="{DynamicResource UmBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="18,22" Spacing="16">

                <Border Classes="hairline" Padding="18">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="eyebrow" Text="{Binding [portfolio.overview], Source={x:Static app:Loc.Instance}}"/>
                    <Grid HorizontalAlignment="Center" Width="132" Height="132">
                      <Ellipse Width="132" Height="132" Stroke="{DynamicResource UmBorder2}" StrokeThickness="12"/>
                      <Ellipse Width="132" Height="132" Stroke="{DynamicResource UmAccentDim}" StrokeThickness="12"/>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Classes="serif" FontSize="22" HorizontalAlignment="Center">
                          <Run Text="{Binding CurrencySymbol}"/><Run Text="{Binding BalanceDisplayMain}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding PortfolioChangePercent}" FontSize="11" Foreground="{Binding PortfolioChangeColor}" HorizontalAlignment="Center"
                                   IsVisible="{Binding AreValuesVisible}"/>
                      </StackPanel>
                    </Grid>
                    <!-- What the total is actually made of: a proportional bar + per-asset legend. -->
                    <TextBlock IsVisible="{Binding !HasBreakdown}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource UmTextMuted}"
                               Text="{Binding [portfolio.overviewEmpty], Source={x:Static app:Loc.Instance}}"/>
                    <StackPanel Spacing="10" IsVisible="{Binding HasBreakdown}">
                      <Border CornerRadius="4" ClipToBounds="True" Height="8" Background="{DynamicResource UmBorder2}">
                        <ItemsControl ItemsSource="{Binding PortfolioBreakdown}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PortfolioSlice">
                              <Border Height="8" Width="{Binding BarWidth}" Background="{Binding Brush}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                      <ItemsControl ItemsSource="{Binding PortfolioBreakdown}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PortfolioSlice">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}"/>
                                <TextBlock Text="{Binding Symbol}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource UmText}"/>
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding PercentLabel}" FontSize="11" Margin="10,0,0,0"
                                         Foreground="{DynamicResource UmTextDim}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontSize="11"
                                         Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"
                                         IsVisible="{Binding #RootWindow.((vm:MainViewModel)DataContext).AreValuesVisible}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding AllocationSummary}" FontSize="10.5" Foreground="{DynamicResource UmTextMuted}"
                                 HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Wallet address widget (§6): the primary address at a glance, with copy + a jump to
                     the Receive screen's QR. Important for a privacy wallet. -->
                <Border Classes="hairline" Padding="16" IsVisible="{Binding IsUnlocked}">
                  <StackPanel Spacing="9">
                    <TextBlock Classes="eyebrow" Text="{Binding [nav.wallet], Source={x:Static app:Loc.Instance}}"/>
                    <TextBlock Classes="mono" FontSize="13" Text="{Binding ShortAddress}" Foreground="{DynamicResource UmText}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding WalletLabel}" FontSize="11" Foreground="{DynamicResource UmTextDim}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                      <Button Classes="chip" Content="{Binding [common.copy], Source={x:Static app:Loc.Instance}}" Command="{Binding CopyPrimaryAddressCommand}"/>
                      <Button Classes="chip" Content="{Binding [nav.receive], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSectionCommand}" CommandParameter="Receive"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="hairline" Padding="16">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="eyebrow" Text="{Binding [portfolio.marketOverview], Source={x:Static app:Loc.Instance}}" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Classes="chip" Content="{Binding [nav.market], Source={x:Static app:Loc.Instance}}" Command="{Binding SelectSectionCommand}" CommandParameter="Market"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Market}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MarketRowViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5" ColumnSpacing="10">
                            <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding PriceLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Classes="mono" FontSize="11" Text="{Binding ChangeLabel}" Foreground="{Binding ChangeColor}" Width="62" TextAlignment="Right" VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </Border>
          </Grid>

          <!-- Floating dock: the price ticker + status, detached from the edges like a macOS dock. -->
          <Border Grid.Row="1" Height="42" Margin="14,4,14,12" CornerRadius="16" Background="{DynamicResource UmCard}"
                  BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1" Padding="18,0"
                  BoxShadow="0 14 38 -12 #90000000, inset 0 1 0 0 #16FFFFFF">
            <Grid ColumnDefinitions="*,Auto">
              <!-- The ticker is wider than its column, so it gets clipped. Without a gap it was cut off
                   flush against the status block on the right, chopping the last price mid-number and
                   reading as two overlapping labels. A margin separates the two zones, and the mask
                   fades the ticker out at its edge so the cut looks deliberate instead of broken. -->
              <ScrollViewer Grid.Column="0" Margin="0,0,18,0"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ClipToBounds="True">
                <ScrollViewer.OpacityMask>
                  <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0.0" Color="#FFFFFFFF"/>
                    <GradientStop Offset="0.90" Color="#FFFFFFFF"/>
                    <GradientStop Offset="1.0" Color="#00FFFFFF"/>
                  </LinearGradientBrush>
                </ScrollViewer.OpacityMask>
                <ItemsControl ItemsSource="{Binding Market}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MarketRowViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center"/>
                        <TextBlock Classes="mono" FontSize="10.5" Text="{Binding PriceLabel}" Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"/>
                        <TextBlock Classes="mono" FontSize="10" Text="{Binding ChangeLabel}" Foreground="{Binding ChangeColor}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource UmPos}" VerticalAlignment="Center"/>
                  <TextBlock Classes="mono" FontSize="10.5" Text="{Binding [status.mainnet], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Classes="mono" FontSize="10.5" Text="{Binding [status.protected], Source={x:Static app:Loc.Instance}}" Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </DockPanel>

      <!-- ===== Mobile "More" sheet: overflow sections that don't fit the 5-slot bottom bar. ===== -->
      <Grid ZIndex="220" IsVisible="{Binding IsMoreSheetOpen}">
        <Border Background="#99000000"/>
        <Button Classes="backdrop" Command="{Binding CloseMoreSheetCommand}"/>
        <Border VerticalAlignment="Bottom" Background="{DynamicResource UmBgAlt}"
                BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0"
                CornerRadius="18,18,0,0" Padding="16,12,16,18">
          <StackPanel Spacing="12">
            <Border Width="42" Height="4" CornerRadius="2" Background="{DynamicResource UmBorder3}" HorizontalAlignment="Center"/>
            <UniformGrid Columns="4">
              <Button Classes="tab" Command="{Binding OpenWalletsCommand}" IsVisible="{Binding IsUnlocked}">
                <StackPanel Spacing="4">
                  <Path Classes="tabIcon" Data="M3 7 H21 V17 H3 Z M16 12 A1.5 1.5 0 1 0 16 11.99 M3 10 H21"/>
                  <TextBlock Text="{Binding ActiveWalletLabel}" FontSize="10" HorizontalAlignment="Center" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
              <!-- Discover folds in Buy / P2P / News, so the More sheet matches the 5-item IA. -->
              <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Discover" Classes.active="{Binding IsDiscoverGroup}">
                <StackPanel Spacing="4">
                  <Path Classes="tabIcon" Data="M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z"/>
                  <TextBlock Text="{Binding [nav.discover], Source={x:Static app:Loc.Instance}}" FontSize="10" HorizontalAlignment="Center" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
              <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Swap" Classes.active="{Binding IsSwap}">
                <StackPanel Spacing="4">
                  <Path Classes="tabIcon" Data="M6 8 H17 L14 5 M18 16 H7 L10 19"/>
                  <TextBlock Text="{Binding [nav.swap], Source={x:Static app:Loc.Instance}}" FontSize="10" HorizontalAlignment="Center" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
              <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Activity" Classes.active="{Binding IsActivity}">
                <StackPanel Spacing="4">
                  <Path Classes="tabIcon" Data="M3 12 H7 L10 5 L14 19 L17 12 H21"/>
                  <TextBlock Text="{Binding [nav.activity], Source={x:Static app:Loc.Instance}}" FontSize="10" HorizontalAlignment="Center" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
              <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Security" Classes.active="{Binding IsSecurity}">
                <StackPanel Spacing="4">
                  <Path Classes="tabIcon" Data="M12 3 L20 6 V12 C20 16.4 16.6 19.7 12 21 C7.4 19.7 4 16.4 4 12 V6 Z"/>
                  <TextBlock Text="{Binding [nav.security], Source={x:Static app:Loc.Instance}}" FontSize="10" HorizontalAlignment="Center" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
              <Button Classes="tab" Command="{Binding SelectSectionCommand}" CommandParameter="Settings" Classes.active="{Binding IsSettings}">
                <StackPanel Spacing="4">
                  <Path Classes="tabIcon" Data="M12 9 A3 3 0 1 0 12 15 A3 3 0 0 0 12 9 M12 2 V5 M12 19 V22 M2 12 H5 M19 12 H22 M5.2 5.2 L7.3 7.3 M16.7 16.7 L18.8 18.8 M18.8 5.2 L16.7 7.3 M7.3 16.7 L5.2 18.8"/>
                  <TextBlock Text="{Binding [nav.settings], Source={x:Static app:Loc.Instance}}" FontSize="10" HorizontalAlignment="Center" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
              <Button Classes="tab" Command="{Binding LockCommand}">
                <StackPanel Spacing="4">
                  <Path Classes="tabIcon" Data="M7 10 V7 A5 5 0 0 1 17 7 V10 M5 10 H19 V21 H5 Z M12 14 V17"/>
                  <TextBlock Text="{Binding [nav.lock], Source={x:Static app:Loc.Instance}}" FontSize="10" HorizontalAlignment="Center" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ============================ AMBIENT RAIN ============================
         A faint curtain of streaks drifting down over the whole window — atmosphere for the
         fear theme. Non-interactive, and gated by the motion toggle so it vanishes with the
         other animations. Sits above the content but below the modals that follow. -->
    <!-- Aurora glow (opt-in). Two soft blobs drifting behind everything; never captures input. -->
    <Panel Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"
           IsVisible="{Binding AuroraVisible}">
      <Ellipse Classes="auroraA" Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-160,0,0"/>
      <Ellipse Classes="auroraB" Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-180"/>
    </Panel>

    <Canvas Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"
            IsVisible="{Binding RainVisible}">
      <Rectangle Classes="raindrop rd3" Height="50" Canvas.Left="90"/>
      <Rectangle Classes="raindrop rd7" Height="34" Canvas.Left="210"/>
      <Rectangle Classes="raindrop rd1" Height="60" Canvas.Left="330"/>
      <Rectangle Classes="raindrop rd9" Height="40" Canvas.Left="440"/>
      <Rectangle Classes="raindrop rd5" Height="30" Canvas.Left="560"/>
      <Rectangle Classes="raindrop rd10" Height="58" Canvas.Left="680"/>
      <Rectangle Classes="raindrop rd2" Height="44" Canvas.Left="800"/>
      <Rectangle Classes="raindrop rd6" Height="62" Canvas.Left="920"/>
      <Rectangle Classes="raindrop rd8" Height="36" Canvas.Left="1050"/>
      <Rectangle Classes="raindrop rd4" Height="52" Canvas.Left="1180"/>
    </Canvas>

    <!-- ============================ COMMAND PALETTE (Ctrl+K) ============================
         A pro-desktop quick launcher: jump to any screen or a coin's chart. Overlay only —
         it never touches the underlying screens. Esc or a backdrop click closes it. -->
    <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsCommandPaletteOpen}" Background="#CC07060D">
      <Border.Transitions>
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut"/></Transitions>
      </Border.Transitions>
      <Border.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommandPaletteCommand}"/>
      </Border.KeyBindings>
      <Grid>
        <Button Classes="backdrop" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseCommandPaletteCommand}"/>
        <Border Classes="card" Width="560" VerticalAlignment="Top" Margin="0,110,0,0" HorizontalAlignment="Center"
                Padding="0" CornerRadius="18" ClipToBounds="True" BorderBrush="{DynamicResource UmAccent}"
                BoxShadow="0 24 64 -18 #B3000000">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="Auto,*" Margin="18,15">
              <TextBlock Text="⌕" FontSize="18" Foreground="{DynamicResource UmTextDim}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" x:Name="PaletteSearch" Margin="10,0,0,0" BorderThickness="0" MinHeight="0"
                       Background="Transparent" Text="{Binding CommandQuery}"
                       Watermark="{Binding [palette.search], Source={x:Static app:Loc.Instance}}">
                <!-- Keyboard-only operation: ↑/↓ walk the results (they wrap), Enter runs the
                     highlighted one. Bound on the search box because focus stays there while typing. -->
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding RunTopPaletteCommandCommand}"/>
                  <KeyBinding Gesture="Down" Command="{Binding PaletteMoveDownCommand}"/>
                  <KeyBinding Gesture="Up" Command="{Binding PaletteMoveUpCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
            </Grid>
            <Border Grid.Row="1" BorderBrush="{DynamicResource UmBorder}" BorderThickness="0,1,0,0"/>
            <ScrollViewer Grid.Row="2" MaxHeight="360" x:Name="PaletteScroll">
              <ItemsControl ItemsSource="{Binding CommandResults}" Margin="8" x:Name="PaletteList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteCommand">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,1" Classes.pick="{Binding IsSelected}"
                            Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).RunPaletteCommandCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="26,*">
                        <TextBlock Text="{Binding Glyph}" FontSize="15" Foreground="{DynamicResource UmAccentBright}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13.5"/>
                          <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource UmTextDim}"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ============================ QR POPUP ============================
         Sits in the last row of the root grid so it covers the whole window,
         including the sidebar. Clicking the dimmed backdrop closes it. -->
    <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsQrPopupOpen}"
            Background="#CC07060D">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
        </Transitions>
      </Border.Transitions>
      <Grid>
        <!-- Backdrop click-to-close. Needs the .backdrop class: a plain Button still picks up
             Fluent's hover/pressed brushes, which flashed the scrim white then blue. -->
        <Button Classes="backdrop" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseQrPopupCommand}"/>

        <Border Classes="card" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="26" CornerRadius="20" BorderBrush="{DynamicResource UmAccent}">
          <Border.Transitions>
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
            </Transitions>
          </Border.Transitions>
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding SelectedReceiveSymbol}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource UmPos}" TextWrapping="Wrap"
                           Text="{Binding SelectedReceiveNetwork}"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="chip" Content="✕" VerticalAlignment="Top"
                      AutomationProperties.Name="{Binding [common.cancel], Source={x:Static app:Loc.Instance}}"
                      Command="{Binding CloseQrPopupCommand}"/>
            </Grid>

            <!-- Token-network warning: USDT/USDC are contracts on one specific chain; a transfer over any
                 other network is unrecoverable, so say it plainly right on the receive screen. -->
            <Border IsVisible="{Binding IsTokenReceive}" Background="#22E7CA83"
                    BorderBrush="#E7CA83" BorderThickness="1" CornerRadius="10" Padding="12">
              <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="#E7CA83"
                           Text="{Binding [receive.tokenWarnTitle], Source={x:Static app:Loc.Instance}}"/>
                <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource UmTextSoft}"
                           Text="{Binding SelectedReceiveNetwork}"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UmTextDim}"
                           Text="{Binding [receive.tokenWarnBody], Source={x:Static app:Loc.Instance}}"/>
              </StackPanel>
            </Border>

            <!-- Address-reuse warning (secure roadmap 3.3). Only shown once the chain has actually
                 confirmed this address has history — an unreachable explorer stays silent rather
                 than crying wolf, and never claims the address is fresh either. -->
            <Border IsVisible="{Binding ReceiveAddressReused}" Background="#22E7CA83"
                    BorderBrush="#E7CA83" BorderThickness="1" CornerRadius="10" Padding="12">
              <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="#E7CA83" TextWrapping="Wrap"
                           Text="{Binding [receive.reuseTitle], Source={x:Static app:Loc.Instance}}"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource UmTextDim}"
                           Text="{Binding [receive.reuseBody], Source={x:Static app:Loc.Instance}}"/>
                <Button Classes="ghost" HorizontalAlignment="Left" Padding="10,5" MinHeight="0" Margin="0,4,0,0"
                        Content="{Binding [receive.newAddrBtn], Source={x:Static app:Loc.Instance}}"
                        Command="{Binding NewReceiveAddressCommand}"/>
              </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding ReceiveAddressCheckPending}" FontSize="11"
                       HorizontalAlignment="Center" Foreground="{DynamicResource UmTextMuted}"
                       Text="{Binding [receive.reuseChecking], Source={x:Static app:Loc.Instance}}"/>

            <Border Background="#FFFFFF" Padding="14" CornerRadius="14"
                    Width="260" Height="260" HorizontalAlignment="Center">
              <Image Source="{Binding ReceiveQr}" Stretch="Uniform"
                     IsVisible="{Binding ReceiveQr, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </Border>

            <TextBlock FontSize="12" Foreground="{DynamicResource UmTextDim}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding [receive.scan], Source={x:Static app:Loc.Instance}}"/>

            <Border Background="{DynamicResource UmCard}" BorderBrush="{DynamicResource UmBorder2}" BorderThickness="1"
                    CornerRadius="10" Padding="12">
              <TextBlock Classes="mono" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{DynamicResource UmTextSoft}" Text="{Binding SelectedReceiveAddress}"/>
            </Border>

            <!-- Requested amount: folded into a BIP21 payment URI so the sender's wallet pre-fills it.
                 Offered only where the URI scheme is a universal standard (BTC/LTC/DOGE). -->
            <StackPanel Spacing="5" IsVisible="{Binding CanRequestAmount}">
              <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                         Text="{Binding [receive.requestAmount], Source={x:Static app:Loc.Instance}}"/>
              <!-- USD quick-entry, mirroring Send: typing here fills the coin field below, and only the
                   coin amount is ever encoded into the BIP21 URI the sender scans. -->
              <StackPanel Spacing="3" IsVisible="{Binding ReceiveFiatAvailable}">
                <TextBox Text="{Binding ReceiveFiatAmount}"
                         Watermark="{Binding [receive.fiatPlaceholder], Source={x:Static app:Loc.Instance}}"/>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" Margin="2,0,0,0"
                           IsVisible="{Binding ReceiveFiatCoinEquiv, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding ReceiveFiatCoinEquiv}"/>
              </StackPanel>
              <TextBox Text="{Binding ReceiveAmount}" Watermark="0.0"/>
              <TextBlock FontSize="11.5" Foreground="{DynamicResource UmTextMuted}" Margin="2,0,0,0"
                         IsVisible="{Binding ReceiveAmountFiat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Text="{Binding ReceiveAmountFiat}"/>
            </StackPanel>

            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{Binding [common.copyAddress], Source={x:Static app:Loc.Instance}}"
                    Command="{Binding CopyAddressCommand}"
                    CommandParameter="{Binding SelectedReceiveAddress}"/>

            <!-- HD receive rotation: a fresh address per request reduces on-chain linking. Safe now
                 that the wallet discovers and spends across every issued index. -->
            <StackPanel Spacing="6" IsVisible="{Binding CanRotateReceive}">
              <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="{Binding [receive.newAddrBtn], Source={x:Static app:Loc.Instance}}"
                      Command="{Binding NewReceiveAddressCommand}"/>
              <TextBlock FontSize="10.5" Foreground="{DynamicResource UmTextMuted}" HorizontalAlignment="Center"
                         TextWrapping="Wrap" TextAlignment="Center"
                         Text="{Binding [receive.newAddrHint], Source={x:Static app:Loc.Instance}}"/>

              <!-- Previous addresses: every index already handed out stays copyable, so funds sent to an
                   older address are never orphaned and the user can re-share one. -->
              <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasReceiveHistory}">
                <TextBlock Classes="eyebrow" Foreground="{DynamicResource UmTextMuted}"
                           Text="{Binding [receive.previous], Source={x:Static app:Loc.Instance}}"/>
                <ItemsControl ItemsSource="{Binding ReceiveHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="ghost" MinHeight="0" Padding="10,6" Margin="0,1"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              ToolTip.Tip="{Binding}"
                              Command="{Binding #RootWindow.((vm:MainViewModel)DataContext).CopyAddressCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding}"/>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ============================ TOAST ============================
         Centered top notification for errors and key notices, auto-hides. Sits above everything,
         non-blocking (only the pill itself is hit-testable). -->
    <Border Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center"
            IsVisible="{Binding ToastVisible}" Margin="0,52,0,0">
      <Button Classes="ghost" Padding="0" Command="{Binding DismissToastCommand}" IsHitTestVisible="True">
        <Border CornerRadius="10" Padding="16,11" MaxWidth="520"
                Background="{DynamicResource UmCard}" BorderThickness="1"
                BorderBrush="{Binding ToastIsError, Converter={StaticResource ToastBorder}}"
                BoxShadow="0 8 28 0 #66000000">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding ToastIsError, Converter={StaticResource ToastGlyph}}" FontSize="15" VerticalAlignment="Center"
                       Foreground="{Binding ToastIsError, Converter={StaticResource ToastBorder}}"/>
            <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource UmText}"/>
          </StackPanel>
        </Border>
      </Button>
    </Border>
  </Grid>
</Window>
