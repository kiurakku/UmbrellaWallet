<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Umbrella.Wallet.App.App"
             xmlns:local="using:Umbrella.Wallet.App"
             RequestedThemeVariant="Dark"
             Name="Umbrella Wallet">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Brand gradients are the same across every palette (they ARE the Umbrella signature), so they
         live here as static resources rather than in the per-theme brush set. -->
    <Application.Resources>
        <LinearGradientBrush x:Key="UmSignature" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#24C6FF"/>
            <GradientStop Offset="0.5" Color="#3478FF"/>
            <GradientStop Offset="1" Color="#795CFF"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UmSignatureHover" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#3FD0FF"/>
            <GradientStop Offset="0.5" Color="#4D8BFF"/>
            <GradientStop Offset="1" Color="#8E72FF"/>
        </LinearGradientBrush>
        <!-- Hero balance surface: a muted navy→blue→violet sweep that stays readable under white text. -->
        <LinearGradientBrush x:Key="UmHeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#183A66"/>
            <GradientStop Offset="0.55" Color="#182444"/>
            <GradientStop Offset="1" Color="#241C46"/>
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- "the fear" palette: a deep indigo-black base lifted with violet, so the app reads
             like the web build instead of flat black. Accents are used for emphasis only. -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource UmBg}" />
            <Setter Property="Foreground" Value="{DynamicResource UmText}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, AvaloniaSans" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Brand accent, reusable from markup -->
        <Style Selector="TextBlock.accent">
            <Setter Property="Foreground" Value="{DynamicResource UmAccentBright}" />
        </Style>
        <Style Selector="TextBlock.accent2">
            <Setter Property="Foreground" Value="#5EEAD4" />
        </Style>

        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource UmTextMuted}" />
        </Style>

        <Style Selector="TextBlock.serif">
            <Setter Property="FontFamily" Value="Georgia, Cambria, Times New Roman, serif" />
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        </Style>

        <!-- Base button: glassy, rounded, springy hover/press, clear disabled state.
             RenderTransformOrigin keeps the press-scale centred instead of pulling to a corner. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.015)" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.965)" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- Sidebar navigation: accent bar on the active item, quiet hover otherwise. -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource UmTextDim}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmHover}" />
            <Setter Property="Foreground" Value="{DynamicResource UmText}" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#2E5AA8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Active nav reads as a soft blue-tinted glass capsule with a faint glow, not a left bar. -->
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#2A3B82FF"/>
                    <GradientStop Offset="1" Color="#14795CFF"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Primary: solid, bold — the single strongest call to action on a screen. -->
        <!-- Primary now carries the theme's accent (auto-contrast label), so each theme restyles the
             main call-to-action, not just the neutrals — orange on The fear, cyan on Blue, and so on. -->
        <!-- Primary and ghost share one fixed height (46) and vertical padding, so a primary+ghost
             row lines up exactly — the primary is just wider, coloured and bold, never taller. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource UmSignature}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="26,13" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmSignatureHover}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmSignatureHover}" />
        </Style>

        <!-- Ghost: quiet secondary action. Frosted-glass fill (translucent white over the
             indigo base) instead of a flat block, so cards read as layered rather than painted. -->
        <Style Selector="Button.ghost">
            <Setter Property="Foreground" Value="{DynamicResource UmText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UmBorder3}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="MinHeight" Value="46" />
            <!-- Frosted glass: brighter at the top edge for a sheen. -->
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#2EFFFFFF" />
                    <GradientStop Offset="1" Color="#0AFFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmCardAlt}" />
        </Style>
        <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmCardAlt}" />
        </Style>

        <!-- Danger: destructive actions (delete vault). -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#241416" />
            <Setter Property="Foreground" Value="#F0A8A8" />
            <Setter Property="BorderBrush" Value="#5E2A2E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A1A1E" />
        </Style>

        <!-- Quick action tile: used on the Portfolio row. Glassy, like the ghost buttons. -->
        <Style Selector="Button.tile">
            <Setter Property="BorderBrush" Value="{DynamicResource UmBorder3}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <!-- Glass key: a bright top-edge sheen so tiles feel raised. -->
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#33FFFFFF" />
                    <GradientStop Offset="1" Color="#0BFFFFFF" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource UmTextSoft}" />
            <Setter Property="Height" Value="68" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style Selector="Button.tile /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmAccentWash}" />
        </Style>
        <!-- Lift on hover so the quick actions feel like physical keys. -->
        <Style Selector="Button.tile">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccentHover}" />
        </Style>
        <Style Selector="Button.tile:pressed">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(0.98)" />
        </Style>

        <!-- Full-width clickable list row (market coins). -->
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Rows are Buttons, so unstyled child text inherits Fluent's control foreground —
                 which stays light and vanishes on the light theme. Pin it to the palette. -->
            <Setter Property="Foreground" Value="{DynamicResource UmText}" />
        </Style>
        <Style Selector="Button.row /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.10" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmHover}" />
            <!-- Fluent also flips the foreground on hover; without this the hovered row
                 turns white-on-light and the coin disappears under the cursor. -->
            <Setter Property="Foreground" Value="{DynamicResource UmText}" />
        </Style>

        <!-- Stroked line icons for the quick-action tiles. Drawn as geometry so they scale
             cleanly and inherit the palette, unlike emoji which vary by installed font. -->
        <Style Selector="Path.tileIcon">
            <Setter Property="Stroke" Value="{DynamicResource UmTextSoft}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tile:pointerover Path.tileIcon">
            <Setter Property="Stroke" Value="{DynamicResource UmAccentBright}" />
        </Style>

        <!-- Invisible full-bleed click target behind a modal. Every visual state must stay
             transparent, otherwise Fluent tints the scrim on hover and press. -->
        <Style Selector="Button.backdrop">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.backdrop /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.backdrop:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.backdrop:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.backdrop:pointerover">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.backdrop:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <!-- Segmented filter chip. -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource UmTextDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.chip /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.10" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmCardAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource UmTextSoft}" />
        </Style>
        <Style Selector="Button.chip.active">
            <!-- Auto-contrast label (dark on a light accent, white on a dark one) so the text on the
                 highlighted chip is always readable — the monochrome accent is near-white. -->
            <Setter Property="Foreground" Value="{DynamicResource UmAccentText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.chip.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmAccentBright}" />
        </Style>

        <!-- Mobile bottom tab: an icon over a tiny label, fixed width, active highlight — the
             phone-style navigation used when Mobile layout is on. -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource UmTextDim}" />
        </Style>
        <Style Selector="Button.tab /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.10" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmCardAlt}" />
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Foreground" Value="{DynamicResource UmAccentBright}" />
        </Style>
        <Style Selector="Button.tab.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmCardAlt}" />
        </Style>
        <Style Selector="Path.tabIcon">
            <Setter Property="Stroke" Value="{DynamicResource UmTextDim}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tab.active Path.tabIcon">
            <Setter Property="Stroke" Value="{DynamicResource UmAccentBright}" />
        </Style>

        <!-- Dropdowns: matched to the glass inputs instead of the default Fluent chrome. -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource UmInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UmBorder2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="Foreground" Value="{DynamicResource UmText}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource UmCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccent}" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccentBright}" />
        </Style>
        <!-- The dropdown surface itself, so the popup isn't a pale default sheet. -->
        <Style Selector="ComboBox /template/ Popup Border">
            <Setter Property="Background" Value="{DynamicResource UmCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UmBorder3}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Foreground" Value="{DynamicResource UmTextSoft}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmHover}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UmAccentSel}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Inputs: subtle by default, bright focus ring so typing feels responsive. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource UmInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UmBorder2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Foreground" Value="{DynamicResource UmText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource UmText}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource UmAccent}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccentDim}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccentBright}" />
            <Setter Property="Background" Value="{DynamicResource UmCard}" />
        </Style>

        <!-- ===== Keyboard focus (accessibility, §8) =====
             A control reached by Tab gets a clear accent outline so keyboard users can always see
             where they are. :focus-visible fires only for keyboard focus, so clicking with the mouse
             never leaves a lingering ring. Buttons get the outline on their template border; text
             inputs and dropdowns already show an accent focus border above, so this fills the gap for
             every clickable control. -->
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccentBright}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBox:focus-visible /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccentBright}" />
        </Style>
        <Style Selector="ToggleButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccentBright}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- Cards get a faint top-down sheen so they sit above the background like glass. -->
        <!-- The sheen is driven by Color resources (a GradientStop needs a Color, not a Brush),
             so cards follow the theme instead of staying dark on the light palette. -->
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="{DynamicResource UmBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Padding" Value="24" />
            <!-- Matte-glass: a bright hairline at the top edge + a soft, deep drop shadow so the card
                 floats above the navy ground like frosted glass. -->
            <Setter Property="BoxShadow" Value="inset 0 1 0 0 #12FFFFFF, 0 20 48 -16 #66000914" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="{DynamicResource UmCardTop}" />
                    <GradientStop Offset="1" Color="{DynamicResource UmCardBottom}" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <!-- A "hero" card variant: the signature gradient surface for the balance / headline block. -->
        <Style Selector="Border.hero">
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Padding" Value="26" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1E3A6B" />
            <Setter Property="Background" Value="{DynamicResource UmHeroGradient}" />
            <Setter Property="BoxShadow" Value="inset 0 1 0 0 #1FFFFFFF, 0 24 60 -20 #7300060F" />
        </Style>

        <Style Selector="Border.hairline">
            <Setter Property="BorderBrush" Value="{DynamicResource UmBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource UmBgAlt}" />
            <!-- Lift the panel off the page so the layout reads as stacked cards, not flat text.
                 Kept soft with a negative spread so it stays subtle on small pill containers too. -->
            <Setter Property="BoxShadow" Value="0 8 22 -8 #4A000000" />
        </Style>

        <!-- Section fade+rise on switch. Applied to the top-level panel of each workspace
             section, so navigating feels like a page turn rather than a hard cut. -->
        <Style Selector=":is(Panel).page, :is(StackPanel).page, :is(Grid).page">
            <Style.Animations>
                <Animation Duration="0:0:0.26" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="14"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Cards ease in, so lists don't snap into place. -->
        <Style Selector="Border.card">
            <Style.Animations>
                <Animation Duration="0:0:0.3" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.985"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Nav items change quietly on hover (background only) — no horizontal slide. -->
        <Style Selector="Button.nav">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- ===== Motion & glass ===== -->
        <!-- Quieter identity: cards no longer lift on hover (a finance surface should sit still). The
             edge still warms slightly so the card the pointer is over is legible, but nothing moves. -->
        <Style Selector="Border.card">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource UmAccentDim}"/>
        </Style>
        <!-- Panels (tables, rail cards) glow their edge on hover without moving. -->
        <Style Selector="Border.hairline">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.hairline:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource UmBorder3}"/>
        </Style>

        <!-- Shimmer skeleton, for loading placeholders (apply Classes="skeleton"). -->
        <Style Selector="Border.skeleton">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#12FFFFFF"/>
                    <GradientStop Offset="0.5" Color="#26FFFFFF"/>
                    <GradientStop Offset="1" Color="#12FFFFFF"/>
                </LinearGradientBrush>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1.3" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.5"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.5"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Ambient "rain" for the fear theme: faint translucent streaks drifting down over the UI.
             The base class carries the look; a speed class carries the fall animation, so each drop
             runs exactly one animation. The whole layer is gated by the motion toggle in markup. -->
        <!-- Kept very faint so it reads as texture behind the content, never as lines crossing text.
             Fully removable in Settings → Appearance → Animation. -->
        <Style Selector="Rectangle.raindrop">
            <Setter Property="Width" Value="1.2" />
            <Setter Property="Fill" Value="#0AFFFFFF" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
        </Style>
        <!-- Ten drops, each with a UNIQUE duration and a UNIQUE start height, and NO delay. Unique
             durations mean the drops drift permanently out of phase and never re-sync, so there is no
             recurring "wave" (the earlier version used a shared Delay + repeating durations, which read
             as a periodic pulse the longer it ran). Unique start offsets scatter them from the first
             frame. End Y is past a maximised window so each drop crosses the whole height smoothly. -->
        <Style Selector="Rectangle.rd1">
            <Style.Animations>
                <Animation Duration="0:0:1.13" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-80" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.80" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.80" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd2">
            <Style.Animations>
                <Animation Duration="0:0:1.47" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-300" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.70" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.70" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd3">
            <Style.Animations>
                <Animation Duration="0:0:0.91" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-160" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.62" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.62" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd4">
            <Style.Animations>
                <Animation Duration="0:0:1.79" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-420" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd5">
            <Style.Animations>
                <Animation Duration="0:0:1.31" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-240" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.75" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.75" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd6">
            <Style.Animations>
                <Animation Duration="0:0:0.83" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-60" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.60" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.60" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd7">
            <Style.Animations>
                <Animation Duration="0:0:1.61" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-360" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.82" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.82" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd8">
            <Style.Animations>
                <Animation Duration="0:0:1.07" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-120" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.70" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.70" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd9">
            <Style.Animations>
                <Animation Duration="0:0:1.93" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-480" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.90" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.90" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.rd10">
            <Style.Animations>
                <Animation Duration="0:0:1.23" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-200" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="10%"><Setter Property="Opacity" Value="0.68" /></KeyFrame>
                    <KeyFrame Cue="90%"><Setter Property="Opacity" Value="0.68" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="1340" /><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Aurora: two large, very faint radial-glow blobs that drift slowly behind the content.
             Opt-in (Settings → Appearance). Non-interactive; gated by the motion toggle in markup. -->
        <Style Selector="Ellipse.auroraA">
            <Setter Property="Fill">
                <RadialGradientBrush>
                    <GradientStop Color="#6E5FE0" Offset="0" />
                    <GradientStop Color="#006E5FE0" Offset="1" />
                </RadialGradientBrush>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:24" IterationCount="INFINITE" Easing="SineEaseInOut" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-70" /><Setter Property="TranslateTransform.Y" Value="-40" /><Setter Property="Opacity" Value="0.05" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="90" /><Setter Property="TranslateTransform.Y" Value="50" /><Setter Property="Opacity" Value="0.12" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.auroraB">
            <Setter Property="Fill">
                <RadialGradientBrush>
                    <GradientStop Color="#2FA8C4" Offset="0" />
                    <GradientStop Color="#002FA8C4" Offset="1" />
                </RadialGradientBrush>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:31" IterationCount="INFINITE" Easing="SineEaseInOut" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="60" /><Setter Property="TranslateTransform.Y" Value="30" /><Setter Property="Opacity" Value="0.10" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="-80" /><Setter Property="TranslateTransform.Y" Value="-20" /><Setter Property="Opacity" Value="0.04" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Thin, unobtrusive overlay scrollbar (Wasabi-like). Track is invisible; only a slim
             thumb shows while scrolling, then auto-hides. -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,4,2,4" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Border#TrackBackground">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar:vertical Thumb">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ScrollBar:vertical Thumb:pointerover">
            <Setter Property="Background" Value="#55FFFFFF" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="6" />
        </Style>
        <!-- Kill the repeat-button arrows so the bar is a clean thin thumb only. -->
        <Style Selector="ScrollBar RepeatButton">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- ===== Animated intro (splash) ===== -->
        <!-- A breathing brand-blue radial glow behind the mark. -->
        <Style Selector="Ellipse.splashGlow">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Fill">
                <RadialGradientBrush>
                    <GradientStop Color="#5534C6FF" Offset="0" />
                    <GradientStop Color="#1A3478FF" Offset="0.45" />
                    <GradientStop Color="#00080D16" Offset="1" />
                </RadialGradientBrush>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:2.8" IterationCount="INFINITE" Easing="SineEaseInOut" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.5" /><Setter Property="ScaleTransform.ScaleX" Value="0.88" /><Setter Property="ScaleTransform.ScaleY" Value="0.88" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.95" /><Setter Property="ScaleTransform.ScaleX" Value="1.06" /><Setter Property="ScaleTransform.ScaleY" Value="1.06" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- The mark scales up and fades in. -->
        <Style Selector="Image.splashLogo">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.95" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.78" /><Setter Property="ScaleTransform.ScaleY" Value="0.78" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Wordmark rises and fades in, slightly after the mark. -->
        <Style Selector="TextBlock.splashTitle">
            <Style.Animations>
                <Animation Duration="0:0:0.7" Delay="0:0:0.35" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="14" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.splashSub">
            <Style.Animations>
                <Animation Duration="0:0:0.7" Delay="0:0:0.62" Easing="CubicEaseOut" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
