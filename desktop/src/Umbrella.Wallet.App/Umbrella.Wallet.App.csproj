<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\umbrella.ico</ApplicationIcon>
    <AssemblyName>Umbrella.Wallet.App</AssemblyName>
    <Product>Umbrella Wallet</Product>
    <AssemblyTitle>Umbrella Wallet</AssemblyTitle>
    <Version>4.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Bundled Tor client. These must land on disk next to the exe (not embedded as
         Avalonia resources) because tor.exe is launched as a real child process. -->
    <Content Include="tor\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Monero's own wallet daemon. Monero balances/spends cannot be computed without it. -->
    <Content Include="monero\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Labs.Lottie" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbrella.Wallet.Core\Umbrella.Wallet.Core.csproj" />
    <ProjectReference Include="..\Umbrella.Wallet.Infrastructure\Umbrella.Wallet.Infrastructure.csproj" />
  </ItemGroup>
</Project>
