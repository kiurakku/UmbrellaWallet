<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- Pin patched versions to override vulnerable 4.3.0 transitives pulled in by the test SDK
         (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj). Test-only — never shipped in the wallet. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zcash's own sighash vectors, trimmed to the transparent-signing cases this wallet builds. -->
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbrella.Wallet.Core\Umbrella.Wallet.Core.csproj" />
    <ProjectReference Include="..\..\src\Umbrella.Wallet.Infrastructure\Umbrella.Wallet.Infrastructure.csproj" />
    <!-- Lets tests drive MainViewModel commands directly, which is where the reported
         "no phrase is generated" bug actually lived. -->
    <ProjectReference Include="..\..\src\Umbrella.Wallet.App\Umbrella.Wallet.App.csproj" />
  </ItemGroup>

</Project>
