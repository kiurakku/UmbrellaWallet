# ─────────────────────────────────────────────────────────────
#  Umbra Wallet — monorepo .gitignore
#  web (Vite + React) · backend (NestJS + Prisma) · desktop (.NET + Avalonia)
# ─────────────────────────────────────────────────────────────

# ── Operating system ──────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ── Editors / IDEs ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.user
*.sw?

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment / secrets ─────────────────────────────────────
# Real env files never get committed; *.example templates stay tracked.
.env
.env.*
.envrc
.dev.vars
!.env.example
!.env.*.example

# ── Node / web: build output + caches ─────────────────────────
node_modules/
dist/
dist-ssr/
.output/
.nitro/
.vinxi/
.tanstack/
.cache/
.turbo/
*.tsbuildinfo
.eslintcache
coverage/
*.lcov

# ── Backend (NestJS) ──────────────────────────────────────────
backend/node_modules/
backend/dist/
# Prisma migrations ARE tracked; a local SQLite db is not.
backend/prisma/*.db
backend/prisma/*.db-journal

# ── Desktop (.NET / Avalonia): build output ───────────────────
desktop/**/bin/
desktop/**/obj/
desktop/artifacts/
# Ignore stray solution files, but keep the real one.
*.sln
!desktop/Umbrella.Wallet.sln

# ── Desktop: packaged installers / portable builds ────────────
desktop/dist/

# ── Bundled third-party binaries (fetched by scripts, not committed) ──
# Tor (~35 MB) — restage with desktop/scripts/fetch-tor.ps1; the README is tracked.
desktop/src/Umbrella.Wallet.App/tor/*
!desktop/src/Umbrella.Wallet.App/tor/README.md
# monero-wallet-rpc (~39 MB) — staged by scripts; the README is tracked.
desktop/src/Umbrella.Wallet.App/monero/*
!desktop/src/Umbrella.Wallet.App/monero/README.md

# ── Deploy / local tooling ────────────────────────────────────
.vercel/
.wrangler/
.kiro/
.claude/

# ── Local AI / scratch prompts ────────────────────────────────
CURSOR_PROMPT.md

# ── Local scratch / temp hardening dumps ──────────────────────
.tmp-ruleset.json
.github/tmp-ruleset*.json
debug.log

# Source media dumps at repo root (real assets live under docs/ or Assets/)
/lockscreen.jpg
/portfolio-static.jpg
/rain-portfolio.mp4
/*.mp4
